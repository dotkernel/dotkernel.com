{% extends '@layout/default.html.twig' %}

{% set routeName = 'page::frontend' %}
{% set meta = {
    title: 'Dotkernel Frontend | Server-rendered PHP web starter',
    description: 'Dotkernel Frontend is a web starter skeleton on Mezzio and Laminas - user accounts, a contact form, '
        ~ 'RBAC guards, CSRF-protected forms, flash messages and GDPR account anonymization, server-rendered in Twig.',
} %}

{% block title %}Dotkernel Frontend{% endblock %}

{% block stylesheets %}
    <style>
        /* Requirement and reference tables - scoped to this page, uses the shared theme tokens. */
        .spec-table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); }
        .spec-table { width: 100%; border-collapse: collapse; font-size: 14.5px; background: var(--surface); }
        .spec-table th, .spec-table td { padding: 14px 18px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--border); }
        .spec-table thead th { font-family: var(--mono); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--text-dim); background: var(--surface-2); }
        .spec-table tbody tr:last-child th, .spec-table tbody tr:last-child td { border-bottom: 0; }
        .spec-table tbody th { font-weight: 500; color: var(--text-muted); white-space: nowrap; }
        .spec-table td { color: var(--text); }
        .spec-note { margin-top: 14px; font-size: 13.5px; color: var(--text-dim); }
        .step-cmd { display: block; margin-top: 12px; font-family: var(--mono); font-size: 12.5px; color: var(--teal); overflow-x: auto; }

        /* Three site-type icons in the hero - scoped to this page. */
        .web-icons { display: flex; gap: 14px; margin-top: 6px; }
        .web-icon { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8px; }
        .web-icon svg { width: 100%; height: auto; display: block; }
        .web-icon span { font-family: var(--mono); font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--text-dim); }
        .wi-frame { fill: var(--surface); stroke: var(--border); stroke-width: 1.5; }
        .wi-chrome { stroke: var(--border); stroke-width: 1; }
        .wi-dot { fill: var(--border); }
        .wi-thumb { fill: var(--border-soft); }
        .wi-title { stroke: var(--page-accent, var(--sage)); stroke-width: 3; stroke-linecap: round; }
        .wi-text { stroke: var(--text-dim); stroke-width: 1.5; opacity: .65; stroke-linecap: round; }
        .wi-body { stroke: var(--text-dim); stroke-width: 2; opacity: .8; stroke-linecap: round; }
    </style>
{% endblock %}

