                    <div><span>Container</span> PSR-11</div>
                    <div><span>Logging</span> PSR-3</div>
                </div>
            </div>

            <div class="hero-visual">
                <figure class="hero-art">
                    <figcaption>Nineteen stages, folded</figcaption>
                    <svg viewBox="0 0 360 170" role="img" aria-label="Nineteen pipeline stages folded into three rows">
                        <path class="art-accent" d="M24 44 H286 A20 20 0 0 1 286 84 H74 A20 20 0 0 0 74 124 H336"/>
                        <line class="art-hot" x1="24" y1="36" x2="24" y2="52"/>
                        <line x1="68" y1="38" x2="68" y2="50"/>
                        <line x1="112" y1="38" x2="112" y2="50"/>
                        <line x1="156" y1="38" x2="156" y2="50"/>
                        <line x1="200" y1="38" x2="200" y2="50"/>
                        <line x1="244" y1="38" x2="244" y2="50"/>
                        <line x1="286" y1="38" x2="286" y2="50"/>
                        <line x1="270" y1="78" x2="270" y2="90"/>
                        <line x1="226" y1="78" x2="226" y2="90"/>
                        <line x1="182" y1="78" x2="182" y2="90"/>
                        <line x1="138" y1="78" x2="138" y2="90"/>
                        <line x1="94" y1="78" x2="94" y2="90"/>
                        <line x1="74" y1="78" x2="74" y2="90"/>
                        <line x1="118" y1="118" x2="118" y2="130"/>
                        <line x1="162" y1="118" x2="162" y2="130"/>
                        <line x1="206" y1="118" x2="206" y2="130"/>
                        <circle class="art-dot" cx="250" cy="124" r="5"/>
