                    </svg>
                </figure>

                <div class="pipeline">
                    <div class="pipeline-label"><span>Five phases</span><span>19 stages</span></div>
                    <div class="pipeline-track">
                        <div class="pl-packet" aria-hidden="true"></div>
                        <div class="pl-step"><span class="name">Error boundary</span><span class="tag">1 stage</span></div>
                        <div class="pl-step"><span class="name">Request preparation</span><span class="tag">4 stages</span></div>
