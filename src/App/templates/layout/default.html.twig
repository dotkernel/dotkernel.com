<!DOCTYPE html>
<html lang="en">
    <head>

        {% include '@partial/meta.html.twig' %}
        {% block canonical %}<link rel="canonical" href="{{ url(routeName ?? null) }}" />{% endblock %}
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('images/app/favicon/apple-touch-icon.png') }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('images/app/favicon/favicon-32x32.png') }}">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('images/app/favicon/favicon-16x16.png') }}">
        <link rel="manifest" href="{{ asset('images/app/favicon/site.webmanifest') }}">
        <link href="https://use.fontawesome.com/releases/v5.0.6/css/all.css" rel="stylesheet" />
        <link href="https://fonts.googleapis.com/css?family=Montserrat:300,400,500,600" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600" rel="stylesheet">

        <link href="{{ asset('css/app.css') }}" rel="stylesheet" />

        {% block stylesheets %}{% endblock %}
    </head>
    <body class="app d-flex flex-column min-vh-100 bg-light text-secondary {% block body_class %}{% endblock %}">

        <header class="app-header sticky-top bg-white border-bottom shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-light py-3">
            <div class="container">
                <a href="/" class="navbar-brand d-flex align-items-center">
                    <img src="{{ asset('images/app/logo.svg') }}"
                         onerror="this.onerror=null; this.src='{{ asset('images/app/logo.png') }}';"
                         alt="Dotkernel"
                         style="height: 32px;" />
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarHeader"
                        aria-controls="navbarHeader" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarHeader">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fw-medium text-dark" href="#" id="pageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Pages
                            </a>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2 z-3" aria-labelledby="pageDropdown">
                                <a class="dropdown-item py-2" href="{{ url('page::about') }}">About Us</a>
                                <a class="dropdown-item py-2" href="{{ url('page::who-we-are') }}">Who We Are</a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item py-2" href="{{ url('page::blog') }}">Posts</a>
                                <a class="dropdown-item py-2" href="{{ url('page::categories') }}">Categories</a>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="https://github.com/dotkernel/light/" target="_blank">GitHub</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="https://docs.dotkernel.org/light-documentation/" target="_blank">Documentation</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link disabled opacity-50" href="{{ url('app::index') }}">Disabled</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

        <main class="app-content flex-grow-1 py-5">
            <div class="container">
                <header class="content-header mb-4">
                    {% block page_title %}{% endblock %}
                </header>

                <section class="content">
                    {% block content %}{% endblock %}
                </section>
            </div>
        </main>

        <footer class="app-footer bg-white border-top py-4 mt-auto text-muted">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <p class="enjoy text-uppercase tracking-wider small fw-bold text-primary mb-0">
                enjoy dotkernel
            </p>
            <p class="mb-0 small">
                &copy; 2024 - {{ 'now'|date('Y') }} Dotkernel by Apidemia
            </p>
        </div>
    </footer>

        <script src="{{ asset('js/app.js') }}"></script>
        {% block javascript %}{% endblock %}
    </body>
</html>