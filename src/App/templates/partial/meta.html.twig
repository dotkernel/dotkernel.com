{% set ogDescription = meta.description ?? meta.excerpt ?? app.meta.description %}
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="msapplication-TileColor" content="#2d89ef">
    <meta name="theme-color" content="#ffffff">
    <title>{{ meta.title ?? meta.name ?? app.meta.title }}</title>
    <meta name="description"         content="{{ ogDescription }}"/>
    {% if articleAuthor is defined %}
    <meta name="author" content="{{ articleAuthor }}"/>
    {% endif %}
    <meta property="og:title"        content="{{ meta.title ?? meta.name ?? app.meta.title }}"/>
    <meta property="og:description"  content="{{ ogDescription }}"/>
    <meta property="og:image"        content="{{ ogImageUrl }}"/>
    <meta property="og:image:alt"    content="{{ ogDescription }}"/>
    <meta property="og:type"         content="{{ meta.type ?? (ogType ?? app.meta.type) }}"/>
    <meta property="og:site_name"    content="{{ app.meta.siteName }}"/>
    <meta property="og:url"          content="{{ meta.url ?? (canonicalUrl ?? (routeName is defined and routeName ? url(routeName) : app.url)) }}"/>
    <meta property="og:locale"       content="{{ app.meta.locale }}"/>
    {% if publishedTime is defined %}
    <meta property="article:published_time" content="{{ publishedTime }}"/>
    {% endif %}
    <meta name="twitter:card"        content="{{ app.meta.twitterCard }}"/>
    <meta name="twitter:site"        content="{{ app.meta.twitterSite }}"/>
    <meta name="twitter:title"       content="{{ meta.title ?? meta.name ?? app.meta.title }}"/>
    <meta name="twitter:description" content="{{ ogDescription }}"/>
    <meta name="twitter:image"       content="{{ ogImageUrl }}"/>
    <meta name="twitter:image:alt"   content="{{ ogDescription }}"/>
