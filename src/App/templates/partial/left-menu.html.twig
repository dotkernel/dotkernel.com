<aside class="sidebar">
    <div class="widget">
        <form class="search-form" onsubmit="return false;">
            <input type="search" placeholder="Search articles…" aria-label="Search articles">
            <button type="submit">Search</button>
        </form>
    </div>

    {% if data is defined and data is iterable %}
        <div class="widget widget-recent">
            <div class="widget-title">Recent Articles</div>
            <ul>
                {% for article in data.items|slice(0, 3) %}
                    <li>
                        <a href="{{ url('page::blog-resource', {categorySlug: article.category.slug, slug: article.slug}) }}">{{ article.title }}</a>
                        <span class="post-date">{{ article.postDate|date('M d, Y') }}</span>
                    </li>
                {% else %}
                    <li class="no-articles">No recent articles.</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="widget widget-categories">
        <div class="widget-title">Categories</div>
        <ul>
            {% for category in categories %}
                <li>
                    <a href="{{ url('page::category-resource', {slug: category.slug}) }}">
                        {{ category.name }}
                        <span class="cat-count">{{ category.publishedPostsCount }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
        <div class="widget-more">
            <a href="{{ url('page::categories') }}">See all categories -></a>
        </div>
    </div>

    {% if posts is defined and posts is iterable %}
        <div class="widget widget-recent">
            <div class="widget-title">Recent Articles</div>
            <ul>
                {% for post in posts %}
                    <li>
                        <a href="{{ url('page::blog-resource', {categorySlug: post.category.slug, slug: post.slug}) }}">{{ post.title }}</a>
                        <span class="post-date">{{ post.postDate|date('M d, Y') }}</span>
                    </li>
                {% else %}
                    <li class="no-articles">No recent articles.</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="widget widget-connect">
        <div class="widget-title">Connect With Us</div>
        <ul>
            <li>
                <a href="https://www.dotkernel.com">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 4 6 4 9s-1.5 6.3-4 9c-2.5-2.7-4-6-4-9s1.5-6.3 4-9z"/></svg>
                    Dotkernel Headless Platform
                </a>
            </li>
            <li>
                <a href="https://www.dotkernel.org" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 4 3 12l5 8M16 4l5 8-5 8"/></svg>
                    Dotkernel API
                </a>
            </li>
            <li>
                <a href="https://github.com/dotkernel/" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a12 12 0 0 0-3.79 23.4c.6.1.83-.27.83-.58v-2.17c-3.34.73-4.04-1.42-4.04-1.42-.55-1.4-1.34-1.77-1.34-1.77-1.08-.75.09-.73.09-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.84 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.53.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.3-1.55 3.3-1.23 3.3-1.23.66 1.65.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .31.22.69.83.57A12 12 0 0 0 12 .5z"/></svg>
                    Dotkernel at Github
                </a>
            </li>
            <li>
                <a href="https://packagist.org/search/?q=dotkernel/" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/></svg>
                    Dotkernel at Packagist
