{% extends '@layout/default.html.twig' %}

{% block title %}404 Not Found{% endblock %}
{% block canonical %}{% endblock %}

{% block content %}
    <div class="page-intro home-intro error-messages">
        <div class="container">
            <h2>Oops!</h2>
            <h2>This is awkward.</h2>
            <h1>404</h1>
            <p class="text-dark">
                You are looking for something that doesn't exist or may have moved. Check out one of the links on this page
                or head back to <a class="text-dark" href="{{ path('app::index') }}">Home</a>.
            </p>

            {% if categories is defined and categories|length > 0 %}
                <div class="d-flex flex-wrap gap-2">
                    {% for category in categories %}
                        <a href="{{ url('page::category-resource', {slug: category.slug}) }}"
                           class="badge bg-primary-subtle text-primary text-uppercase fw-bold text-decoration-none px-3 py-2 rounded-pill">
                            {{ category.name }}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
