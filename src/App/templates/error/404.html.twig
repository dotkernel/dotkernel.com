{% extends '@layout/default.html.twig' %}

{% block title %}404 Not Found{% endblock %}
{% block canonical %}{% endblock %}

{% block content %}
    <section class="hero">
        <div class="wrap">
            <span class="eyebrow">Oops! This is awkward.</span>
            <h1 class="error-code">404</h1>
            <p class="sub error-sub">
                You are looking for something that doesn't exist or may have moved.<br>
                Return to the homepage below, or head to the Blog.
            </p>

            <div class="hero-ctas error-buttons">
                <a class="btn btn-primary" href="{{ path('app::index') }}">Back to Home</a>
                <a class="btn btn-ghost" href="{{ url('page::blog') }}">Browse new posts</a>
            </div>

            {% if categories is defined and categories|length > 0 %}
                <div class="d-flex flex-wrap gap-2 mt-4">
                    {% for category in categories %}
                        <a href="{{ url('page::category-resource', {slug: category.slug}) }}"
                           class="badge bg-primary-subtle text-primary text-uppercase fw-bold text-decoration-none px-3 py-2 rounded-pill">
                            {{ category.name }}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}

            {% if authors is defined and authors|length > 0 %}
                <div class="d-flex flex-wrap gap-2 mt-4">
                    {% for author in authors %}
                        <a href="{{ url('page::author-resource', {slug: author.slug}) }}"
                           class="badge bg-primary-subtle text-primary text-uppercase fw-bold text-decoration-none px-3 py-2 rounded-pill">
                            {{ author.name }}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
