{% extends '@layout/blog-post.html.twig' %}

{% block body %}
{{ content|markdown_to_html }}

{% if faq is not empty %}
<h2 id="user-content-faq">Frequently Asked Questions</h2>

<div class="faq-list">
    {% for item in faq %}
    <details class="acc"{% if loop.first %} open{% endif %}>
        <summary>{{ item.question }} <span class="chev">+</span></summary>
        <div class="acc-body">
            <p class="mb-0">{{ item.answer }}</p>
        </div>
    </details>
    {% endfor %}
</div>
{% endif %}
{% endblock %}
