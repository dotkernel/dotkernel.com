{% extends '@layout/default.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block page_title %}
    <div class="wrap">
        <div class="post-hero">
            <a href="{{ url('page::categories') }}" class="breadcrumb-back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                All Categories
            </a>
            <div><span class="eyebrow">Category</span></div>
            <h1>{{ category.name }}</h1>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="wrap post-body-wrap">
        <div class="post-layout">

            {{ include('@partial/left-menu.html.twig') }}

            <main class="article">
                <div class="posts-list">
                    {% for article in categoryArticles %}
                        <article class="card my-3">
                            <h3>
                                <a href="{{ url('page::blog-resource', {categorySlug: article.category.slug, slug: article.slug}) }}">
                                    {{ article.title }}
                                </a>
                            </h3>

                            <p class="desc">{{ article.excerpt }}</p>

                            <div class="d-flex flex-column align-items-start gap-2 pt-3 border-top">
                                <span class="post-date">
                                    By <a href="{{ path('page::author-resource', {slug: article.author.slug}) }}">{{ article.author.name }}</a>
                                    &nbsp;·&nbsp; {{ article.postDate|date('M d, Y') }}
                                </span>
                                <a href="{{ url('page::blog-resource', {categorySlug: article.category.slug, slug: article.slug}) }}"
                                   class="btn btn-ghost btn-sm">
                                    Read more →
                                </a>
                            </div>
                        </article>
                    {% else %}
                        <div class="card posts-empty">
                            <p class="desc">No posts in this category yet.</p>
                        </div>
                    {% endfor %}
                </div>
            </main>

        </div>
    </div>
{% endblock %}
