{% extends '@layout/default.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block content %}
    <div class="row g-4 z-0">
        <header class="mb-4 pb-3 border-bottom">
            <span class="text-uppercase text-muted small fw-bold d-block mb-1">Category</span>
            <h1 class="display-6 fw-bold text-dark mb-0">{{ category.name }}</h1>
        </header>
        {{ include('@partial/left-menu.html.twig') }}

        <main class="col-lg-9 col-md-8">

            <div class="posts d-flex flex-column gap-3">
                {% for article in categoryArticles %}
                    <article class="card border-0 shadow-sm rounded-3 card-hover transition">
                        <div class="card-body p-4">
                            <h3 class="h5 mb-0">
                                <a href="{{ url('page::blog-resource', {categorySlug: article.category.slug, slug: article.slug}) }}"
                                   class="text-decoration-none text-dark link-primary fw-semibold stretched-link">
                                    {{ article.title }}
                                </a>
                            </h3>
                            <p class="text-muted mb-0 mt-1">{{ article.excerpt }}</p>
                            <p class="text-muted small mt-2">
                                <i class="far fa-clock me-1"></i>
                                {{ article.postDate|date('d M Y') }}
                            </p>
                            <p class="text-muted small mb-0">
                                By: <a href="{{ path('page::author-resource', {slug: article.author.slug}) }}"
                                       style="position: relative; z-index: 1;">{{ article.author.name }}</a>
                            </p>
                        </div>
                    </article>
                {% else %}
                    <div class="text-center py-5 bg-white rounded-3 border shadow-sm">
                        <i class="far fa-folder-open fa-2x text-muted mb-3"></i>
                        <p class="text-muted mb-0">No posts in this category yet.</p>
                    </div>
                {% endfor %}
            </div>
        </main>

    </div>
{% endblock %}
