{% extends '@layout/default.html.twig' %}

{% block title %}Posts{% endblock %}

{% block content %}
    <div class="row g-4 py-4">

        <aside class="col-lg-3 col-md-4">
            <div class="sticky-top" style="top: 90px; z-index: 10;">

                <div class="card border-0 shadow-sm mb-4 rounded-3">
                    <div class="card-body p-3">
                        <h6 class="fw-bold text-uppercase text-muted small px-1 mb-3">Search</h6>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" class="form-control border-start-0 bg-light shadow-none" placeholder="Search articles…">
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3">
                        <h6 class="fw-bold text-uppercase text-muted small px-1 mb-2">Categories</h6>

                        <div class="list-group list-group-flush mb-3 pe-2" style="max-height: 250px; overflow-y: auto; overflow-x: hidden;">
                            {% for category in categories %}
                                <a href="{{ url('page::category-resource', {slug: category.slug}) }}"
                                   class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-2 px-1 border-0 rounded text-secondary small">
                                    <span>{{ category.name }}</span>
                                    <i class="bi bi-chevron-right text-muted" style="font-size: 10px;"></i>
                                </a>
                            {% endfor %}
                        </div>
                        <div class="pt-2 border-top text-center">
                            <a href="{{ url('page::categories') }}" class="text-primary small fw-semibold text-decoration-none d-inline-flex align-items-center gap-1">
                                See all categories <i class="bi bi-arrow-right fs-7"></i>
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </aside>

        <main class="col-lg-9 col-md-8">

            <header class="mb-4 pb-3 border-bottom">
                <span class="text-uppercase text-muted small fw-bold d-block mb-1">Blog</span>
                <h1 class="display-6 fw-bold text-dark mb-0">Latest Articles</h1>
            </header>

            <div class="posts d-flex flex-column gap-3">
                {% for article in data.items %}
                    <article class="card border-0 shadow-sm rounded-3">
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <h2 class="h5 fw-bold mb-3">
                                    <a href="{{ url('page::blog-resource', {slug: article.slug}) }}" class="link-dark text-decoration-none">
                                        {{ article.title }}
                                    </a>
                                </h2>
{#                                <p class="text-muted small mb-0">Post date {{ article.postDate }}"></p>#}
                            </div>

                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2 pt-3 border-top">
                                <a href="{{ url('page::category-resource', {slug: article.category.slug}) }}"
                                   class="badge bg-light text-secondary text-decoration-none py-2 px-3 border rounded-pill">
                                    <i class="bi bi-tags me-1"></i> Related posts
                                </a>

                                <a href="{{ url('page::blog-resource', {slug: article.slug}) }}" class="text-primary small fw-bold text-decoration-none d-inline-flex align-items-center gap-1">
                                    Read more <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </article>
                {% else %}
                    <div class="text-center py-5 bg-white rounded-3 border shadow-sm">
                        <i class="bi bi-newspaper display-4 text-muted d-block mb-3"></i>
                        <p class="text-muted mb-0">No articles found.</p>
                    </div>
                {% endfor %}
            </div>

            {% if data.lastPage > 1 %}
                <nav class="mt-4 d-flex justify-content-center">
                    <ul class="pagination pagination-sm">

                        <li class="page-item {% if data.isFirstPage %}disabled{% endif %}">
                            <a class="page-link rounded-start-3" href="?page={{ data.previousPage }}">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>

                        {% for p in data.pages %}
                            <li class="page-item {% if p == data.currentPage %}active{% endif %}">
                                <a class="page-link" href="?page={{ p }}">{{ p }}</a>
                            </li>
                        {% endfor %}

                        <li class="page-item {% if data.isLastPage %}disabled{% endif %}">
                            <a class="page-link rounded-end-3" href="?page={{ data.nextPage }}">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>

                    </ul>
                </nav>

                <p class="text-center text-muted small mt-2">
                    Page {{ data.currentPage }} of {{ data.lastPage }}
                    &nbsp;·&nbsp;
                    {{ data.count }} articles total
                </p>
            {% endif %}

        </main>

    </div>
{% endblock %}