{% extends '@layout/default.html.twig' %}

{% block title %}Posts{% endblock %}

{% block page_title %}
    <div class="wrap">
        <div class="post-hero">
            <div><span class="eyebrow">Blog</span></div>
            <h1>Latest Articles</h1>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="wrap post-body-wrap">
        <div class="post-layout">

            {{ include('@partial/left-menu.html.twig') }}

            <main class="article">
                <div class="posts-list">
                    {% for article in data.items %}
                        <article class="card my-3" style="--accent:var(--brand-red)">
                            <div class="card-top">
                                <div>
                                    <a href="{{ url('page::category-resource', {slug: article.category.slug}) }}"
                                       class="kicker">
                                        {{ article.category.name }}
                                    </a>
                                    <h3>
                                        <a href="{{ url('page::blog-resource', {categorySlug: article.category.slug, slug: article.slug}) }}">
                                            {{ article.title }}
                                        </a>
                                    </h3>
                                </div>
                            </div>

                            <p class="desc">{{ article.excerpt }}</p>

                            <div class="card-btns d-flex flex-column align-items-start gap-2 pt-3 border-top">
                                <span class="post-date">
                                    By <a href="{{ path('page::author-resource', {slug: article.author.slug}) }}">{{ article.author.name }}</a>
                                    &nbsp;·&nbsp; {{ article.postDate|date('M d, Y') }}
                                </span>
                                <a href="{{ url('page::blog-resource', {categorySlug: article.category.slug, slug: article.slug}) }}"
                                   class="btn btn-ghost btn-sm">
                                    Read more →
                                </a>
                            </div>
                        </article>
                    {% else %}
                        <div class="card posts-empty">
                            <p class="desc">No articles found.</p>
                        </div>
                    {% endfor %}
                </div>

                {% if data.lastPage > 1 %}
                    <nav class="pagination-row" aria-label="Posts pagination">
                        <a class="btn btn-ghost btn-sm {% if data.isFirstPage %}disabled{% endif %}"
                           href="?page={{ data.previousPage }}" aria-label="Previous page">←</a>

                        {% for p in data.pages %}
                            <a class="btn btn-sm {% if p == data.currentPage %}btn-primary{% else %}btn-ghost{% endif %}"
                               href="?page={{ p }}">{{ p }}</a>
                        {% endfor %}

                        <a class="btn btn-ghost btn-sm {% if data.isLastPage %}disabled{% endif %}"
                           href="?page={{ data.nextPage }}" aria-label="Next page">→</a>
                    </nav>

                    <p class="post-date pagination-summary">
                        Page {{ data.currentPage }} of {{ data.lastPage }}
                        &nbsp;·&nbsp; {{ data.count }} articles total
                    </p>
                {% endif %}
            </main>

        </div>
    </div>
{% endblock %}
