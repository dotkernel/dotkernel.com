{% extends '@layout/default.html.twig' %}

{% block title %}Categories{% endblock %}

{% block content %}
    <div class="row g-4 py-4">

        <aside class="col-lg-3 col-md-4">
            <div class="sticky-top" style="top: 90px; z-index: 10;">

                <div class="card border-0 shadow-sm mb-4 rounded-3">
                    <div class="card-body p-3">
                        <h6 class="fw-bold text-uppercase text-muted small px-1 mb-3">Search</h6>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" class="form-control border-start-0 bg-light shadow-none" placeholder="Search articles…">
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3">
                        <h6 class="fw-bold text-uppercase text-muted small px-1 mb-2">Categories</h6>

                        <div class="list-group list-group-flush">
                            {% for category in categories %}
                                <a href="{{ url('page::category-resource', {slug: category.slug}) }}"
                                   class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-2 px-1 border-0 rounded text-secondary small">
                                    <span>{{ category.name }}</span>
                                    <i class="bi bi-chevron-right text-muted" style="font-size: 10px;"></i>
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                </div>

            </div>
        </aside>

        <main class="col-lg-9 col-md-8">

            <header class="mb-4 pb-3 border-bottom">
                <span class="text-uppercase text-muted small fw-bold d-block mb-1">Explore</span>
                <h1 class="display-6 fw-bold text-dark mb-0">Categories</h1>
            </header>

            <div class="row g-4">
                {% for category in categories %}
                    <div class="col-xl-4 col-md-6 col-sm-12">
                        <div class="card h-100 border-0 shadow-sm rounded-3 position-relative">
                            <div class="card-body p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-folder text-primary fs-5"></i>
                                        <h2 class="h5 fw-bold text-dark mb-0">
                                            <a href="{{ url('page::category-resource', {slug: category.slug}) }}" class="text-decoration-none text-dark stretched-link">
                                                {{ category.name }}
                                            </a>
                                        </h2>
                                    </div>
                                    <p class="text-muted small mb-0">Discover latest articles in this section.</p>
                                </div>

                                <div class="mt-4 pt-2 border-top text-primary small fw-semibold d-flex align-items-center gap-1">
                                    Browse articles <i class="bi bi-arrow-right"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="text-center py-5 bg-white rounded-3 border shadow-sm">
                            <i class="bi bi-folder-x display-4 text-muted d-block mb-3"></i>
                            <p class="text-muted mb-0">No categories found.</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </main>

    </div>
{% endblock %}