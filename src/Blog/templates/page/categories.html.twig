{% extends '@layout/default.html.twig' %}
{% block json_ld %} {{ include('@jsonld/categories.jsonld.twig') }} {% endblock %}

{% block title %}Categories{% endblock %}

{% block page_title %}
    <div class="wrap">
        <div class="post-hero">
            <div><span class="eyebrow">Explore</span></div>
            <h1>Categories</h1>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="wrap post-body-wrap">
        <div class="post-layout">

            {{ include('@partial/left-menu.html.twig') }}

            <main class="article">
                <div class="posts-grid">
                    {% for category in categories %}
                        <a class="post-card" href="{{ url('page::category-resource', {slug: category.slug}) }}">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 style="width:20px;height:20px;color:var(--teal);" aria-hidden="true">
                                <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/>
                            </svg>
                            <h2>{{ category.name }}</h2>
                            <p>Discover latest articles in this section.</p>
                            <span class="read-more">Browse articles →</span>
                        </a>
                    {% else %}
                        <div class="card posts-empty">
                            <p class="desc">No categories found.</p>
                        </div>
                    {% endfor %}
                </div>
            </main>

        </div>
    </div>
{% endblock %}
