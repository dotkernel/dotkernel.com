{% extends '@layout/default.html.twig' %}

{% block title %}Categories{% endblock %}

{% block content %}
    <div class="page-intro">
        <div class="container">
            <p class="welcome">Categories</p>
            <h1>Categories</h1>
        </div>
    </div>

    <div class="container py-5">
        <div class="row g-4">

            <div class="col-lg-3 col-md-4">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h6 class="fw-bold text-uppercase text-muted small mb-3">Search</h6>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-start-0 bg-light" placeholder="Search articles…">
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="fw-bold text-uppercase text-muted small mb-3">Categories</h6>
                        <ul class="list-unstyled mb-0">
                            {% for category in categories %}
                                <li>
                                    <a href="{{ category.slug }}"
                                       class="d-flex align-items-center justify-content-between py-2 px-2 rounded text-decoration-none text-dark hover-item">
                                        <span class="small">{{ category.name }}</span>
                                        <i class="bi bi-chevron-right text-muted" style="font-size: 11px;"></i>
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-lg-9 col-md-8">
                <div class="row g-4">
                    {% for category in categories %}
                        <div class="col-lg-4 col-md-6 col-sm-12">
                            <a href="{{ category.slug }}" class="text-decoration-none">
                                <div class="card h-100 border-0 shadow-sm hover-card">
                                    <div class="card-body d-flex align-items-center justify-content-between p-4">
                                        <div>
                                            <h5 class="card-title fw-bold mb-1 text-dark">{{ category.name }}</h5>
                                        </div>
                                    </div>
                                    <div class="card-footer bg-transparent border-0 px-4 pb-4">
                                        <span class="text-primary small fw-semibold">
                                            Browse articles &rarr;
                                        </span>
                                    </div>
                                </div>
                            </a>
                        </div>
                    {% else %}
                        <div class="col-12">
                            <p class="text-muted text-center py-5">No categories found.</p>
                        </div>
                    {% endfor %}
                </div>
            </div>

        </div>
    </div>
{% endblock %}