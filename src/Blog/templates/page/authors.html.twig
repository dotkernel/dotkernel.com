{% extends '@layout/default.html.twig' %}
{% block json_ld %} {{ include('@jsonld/authors.jsonld.twig') }} {% endblock %}

{% block title %}Authors{% endblock %}

{% block page_title %}
    {{ include('@partial/title-section.html.twig', {
        badge: 'Explore',
        title: 'Authors',
    }) }}
{% endblock %}

{% block content %}
    <div class="wrap post-body-wrap">
        <div class="post-layout">

            {{ include('@partial/left-menu.html.twig') }}

            <main class="article">
                <div class="posts-grid">
                    {% for author in authors %}
                        <a class="post-card" href="{{ url('page::author-resource', {slug: author.slug}) }}">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 style="width:20px;height:20px;color:var(--teal);" aria-hidden="true">
                                <path d="M20 21a8 8 0 0 0-16 0"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                            <h4>{{ author.name }}</h4>
                            <p>Discover latest articles from this author.</p>
                            <span class="read-more">Browse articles -></span>
                        </a>
                    {% else %}
                        <div class="card posts-empty">
                            <p class="desc">No authors found.</p>
                        </div>
                    {% endfor %}
                </div>
            </main>

        </div>
    </div>
{% endblock %}
