{% extends '@layout/default.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block content %}
    <div style="display: grid; grid-template-columns: 260px 1fr; gap: 2rem; padding: 2rem 0;">

        <aside>
            <p>Categories</p>
            <ul>
                {% for cat in categories %}
                    <li class="{{ cat.slug == category.slug ? 'active' : '' }}">
                        <a href="{{ path('page::category-resource', {slug: cat.slug}) }}" class="text-primary small">
                            {{ cat.name }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </aside>

        <main>
            <header>
                <small>Category</small>
                <h1>{{ category.name }}</h1>
            </header>

            <div class="posts">
                {% for article in categoryArticles %}
                    <article>
                        <a href="{{ path('page::blog-resource', {slug: article.slug}) }}" class="fw-semibold text-primary">
                            {{ article.title }}
                        </a>
                    </article>
                {% else %}
                    <p class="text-muted">No posts in this category yet.</p>
                {% endfor %}
            </div>
        </main>

    </div>
{% endblock %}
