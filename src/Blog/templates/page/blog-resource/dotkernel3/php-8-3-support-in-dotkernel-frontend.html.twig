{% extends '@layout/default.html.twig' %}

{% block title %}PHP 8.3 support in Dotkernel Frontend{% endblock %}

{% block page_title %}
    <div class="mb-2 text-uppercase small fw-bold text-primary tracking-wider">Dotkernel 3</div>
    <h1 class="fw-bold text-dark display-6 mb-0">PHP 8.3 support in Dotkernel Frontend</h1>
    <hr class="mt-4 mb-2 opacity-25">
{% endblock %}

{% block content %}
<!-- wp:paragraph -->
<p>To be able to take advantage of the support for <strong>PHP 8.3</strong> in the newest packages, the DotKernel team has updated the <a href="https://github.com/dotkernel/frontend" data-type="link" data-id="https://github.com/dotkernel/frontend" target="_blank" rel="noreferrer noopener">Frontend</a> Application to version <strong>4.2.0</strong>. Very much like for the Admin update before it, the Frontend must also remove support for PHP 8.1 and the no-longer-available PhpFileCache class until a replacement is implemented.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p>The full list of file changes is <a href="https://github.com/dotkernel/frontend/pull/417" data-type="link" data-id="https://github.com/dotkernel/admin/pull/218/files" target="_blank" rel="noreferrer noopener">here</a>.</p>
<!-- /wp:paragraph -->

