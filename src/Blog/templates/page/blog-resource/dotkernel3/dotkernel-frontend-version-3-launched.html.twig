{% extends '@layout/default.html.twig' %}
{% block json_ld %} {{ include('@jsonld/dotkernel3/dotkernel-frontend-version-3-launched.jsonld.twig') }} {% endblock %}

{% block title %}Dotkernel Frontend version 3  launched{% endblock %}

{% block page_title %}
    <div class="wrap">
        <div class="post-hero">
            <a href="{{ url('page::blog') }}" class="breadcrumb-back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                Back to Blog
            </a>
            <div><span class="eyebrow">Dotkernel 3</span></div>
            <h1>{{ article.title }}</h1>
            <div class="post-meta">
                <span class="text-muted small">
                    By <a href="{{ path('page::author-resource', {slug: article.author.slug}) }}" class="fw-bold link-dark text-decoration-none">{{ article.author.name }}</a>
                    &nbsp;.&nbsp; {{ article.postDate|date('M d, Y') }}
                </span>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="wrap post-body-wrap">
        <div class="post-layout">

            {{ include('@partial/left-menu.html.twig') }}

            <article class="article">
                <div class="entry">
<h4>Dotkernel Frontend PHP Application version 3 was launched.</h4>

<p class="mb-3"><a style="display: inline-block;" rel="noopener noreferrer" href="https://github.com/dotkernel/frontend/issues" target="_blank"><img title="GitHub issues" src="https://img.shields.io/github/issues/dotkernel/frontend" class="img-fluid rounded my-2"></a> <a style="display: inline-block;" rel="noopener noreferrer" href="https://github.com/dotkernel/frontend/stargazers" target="_blank"><img title="GitHub stars" src="https://img.shields.io/github/stars/dotkernel/frontend" class="img-fluid rounded my-2"></a> <img title="PHP from Packagist (specify version)" style="display: inline-block;" src="https://img.shields.io/packagist/php-v/dotkernel/frontend/3.0.0" class="img-fluid rounded my-2"><img title="Packagist Version" style="display: inline-block;" src="https://img.shields.io/packagist/v/dotkernel/frontend" class="img-fluid rounded my-2"> <a style="display: inline-block;" rel="noopener noreferrer" href="https://github.com/dotkernel/frontend/blob/3.0/LICENSE.md" target="_blank"><img title="GitHub License" src="https://img.shields.io/github/license/dotkernel/frontend" class="img-fluid rounded my-2"></a></p>

<p class="mb-3"></p>

<p class="mb-3">Dotkernel is a Collection of PSR-7 Middleware applications built on top of <a rel="noreferrer noopener" href="https://getlaminas.org/" target="_blank">Mezzio microframework and using Laminas components</a></p>

<p class="mb-3">You can <strong>clone </strong>it from <a href="https://github.com/dotkernel/frontend" target="_blank" rel="noreferrer noopener">github </a></p>

<p class="mb-3"><strong>Live demo:</strong> <a href="https://v3.dotkernel.net" target="_blank" rel="noreferrer noopener">v3.dotkernel.net</a></p>

<h5>Changelog:</h5>

<p class="mb-3"><em>Branch 3.0 is the current and default branch </em>, and :</p>

<ul><li>Require <strong>Mezzio</strong> <strong>^3.2</strong></li><li>Require <strong>PHP ^7.4</strong></li><li>Require <strong>Doctrine 2.7.x</strong></li><li>Require <strong>Twig 3.x</strong></li><li>Limited dot-* packages to version <strong>3.x</strong> and above</li></ul>

<p class="mb-3">&nbsp;</p>

<p class="mb-3">&nbsp;</p>
                </div>

                {{ include('@partial/post-nav.html.twig') }}
            </article>

        </div>
    </div>
{% endblock %}
