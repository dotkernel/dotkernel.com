{% extends '@layout/default.html.twig' %}

{% block title %}Dotkernel Admin version 3  launched{% endblock %}

{% block page_title %}
    <div class="wrap">
        <div class="post-hero">
            <a href="{{ url('page::blog') }}" class="breadcrumb-back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                Back to Blog
            </a>
            <div><span class="eyebrow">Dotkernel 3</span></div>
            <h1>{{ article.title }}</h1>
            <div class="post-meta">
                <span class="text-muted small">
                    By <a href="{{ path('page::author-resource', {slug: article.author.slug}) }}" class="fw-bold link-dark text-decoration-none">{{ article.author.name }}</a>
                    &nbsp;·&nbsp; {{ article.postDate|date('M d, Y') }}
                </span>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="wrap post-body-wrap">
        <div class="post-layout">

            {{ include('@partial/left-menu.html.twig') }}

            <article class="article">
                <div class="entry">
<p class="mb-3"></p>
<h4>Dotkernel Admin PHP Application version 3 was launched.</h4>
<p class="mb-3"></p>
<p class="mb-3"><br><a style="display: inline-block;" href="https://github.com/dotkernel/frontend/issues" target="_blank" rel="noopener noreferrer"><img title="GitHub issues" src="https://img.shields.io/github/issues/dotkernel/admin" class="img-fluid rounded my-2"></a><a style="display: inline-block;" href="https://github.com/dotkernel/admin/stargazers" target="_blank" rel="noopener noreferrer"><img title="GitHub stars" src="https://img.shields.io/github/stars/dotkernel/admin" class="img-fluid rounded my-2"></a><img style="display: inline-block;" title="PHP from Packagist (specify version)" src="https://img.shields.io/packagist/php-v/dotkernel/admin/3.0.0" class="img-fluid rounded my-2"><img style="display: inline-block;" title="Packagist Version" src="https://img.shields.io/packagist/v/dotkernel/admin" class="img-fluid rounded my-2"> <a style="display: inline-block;" href="https://github.com/dotkernel/admin/blob/3.0/LICENSE.md" target="_blank" rel="noopener noreferrer"><img title="GitHub License" src="https://img.shields.io/github/license/dotkernel/frontend" class="img-fluid rounded my-2"></a></p>
<p class="mb-3"></p>
<p class="mb-3">Dotkernel is a Collection of PSR-7 Middleware applications built on top of <a href="https://getlaminas.org/" target="_blank" rel="noreferrer noopener">Mezzio microframework and using Laminas components</a></p>
<p class="mb-3"></p>
<p class="mb-3"></p>
<p class="mb-3">&nbsp;Dotkernel Admin is a basic admin panel, based on Boostrap ^4.5.0 , using Doctrine and performing basic CRUD operations over a database. <br></p>
<p class="mb-3"></p>
<p class="mb-3"></p>
<p class="mb-3">You can <strong>clone </strong>it from <a href="https://github.com/dotkernel/admin" target="_blank" rel="noreferrer noopener">github </a></p>
<p class="mb-3"></p>
<p class="mb-3"></p>
<p class="mb-3"><strong>Live demo:</strong> <a href="https://admin.dotkernel.net" target="_blank" rel="noreferrer noopener">admin.dotkernel.net</a></p>
<p class="mb-3"></p>
<p class="mb-3"></p>
<h5>Changelog:</h5>
<p class="mb-3"></p>
<p class="mb-3"></p>
<p class="mb-3"><em>Branch 3.0 is the current and default branch </em>, and :</p>
<p class="mb-3"></p>
<p class="mb-3"></p>
<ul>
<li>Require <strong>Mezzio</strong> <strong>^3.2</strong></li>
<li>Require <strong>PHP ^7.4</strong></li>
<li>Require <strong>Doctrine 2.7.x</strong></li>
<li>Require <strong>Twig 3.x</strong></li><li>Require <b>Bootstrap </b>4.5</li>
<li>Limited dot-* packages to version <strong>3.x</strong> and above</li>
</ul>
<p class="mb-3"></p>
<p class="mb-3"></p>
<p class="mb-3">&nbsp;</p>
<p class="mb-3"></p>
<p class="mb-3"></p>
<p class="mb-3">&nbsp;</p>
<p class="mb-3"></p>
                </div>

                {{ include('@partial/post-nav.html.twig') }}
            </article>

        </div>
    </div>
{% endblock %}
