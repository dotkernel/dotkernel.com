{% extends '@layout/default.html.twig' %}

{% block title %}Dotkernel Admin version 3  launched{% endblock %}

{% block page_title %}
    <div class="mb-2 text-uppercase small fw-bold text-primary tracking-wider">Dotkernel 3</div>
    <h1 class="fw-bold text-dark display-6 mb-0">Dotkernel Admin version 3  launched</h1>
    <hr class="mt-4 mb-2 opacity-25">
{% endblock %}

{% block content %}
    <div class="container py-4">
        <div class="row g-4">
            
            {% include '@partial/left-menu.html.twig' %}

            <main class="col-12 col-md-8 col-lg-9">
                <article class="card border-0 shadow-sm p-4 p-md-5 h-100">
                    <header class="mb-4">
                        <h1 class="h2 text-dark fw-bold">Dotkernel Admin version 3  launched</h1>
                        <div class="text-muted small">
                            <i class="bi bi-folder2-open me-1"></i> Dotkernel 3
                        </div>
                    </header>

                    <section class="post-content text-secondary lh-lg fs-6">
                        <p class="mb-3"><!-- wp:heading {"level":4} --></p>
<h4>Dotkernel Admin PHP Application version 3 was launched.</h4>
<p class="mb-3"><!-- /wp:heading --></p>
<p class="mb-3"><!-- wp:paragraph --><br><a style="display: inline-block;" href="https://github.com/dotkernel/frontend/issues" target="_blank" rel="noopener noreferrer"><img title="GitHub issues" src="https://img.shields.io/github/issues/dotkernel/admin" class="img-fluid rounded my-2"></a><a style="display: inline-block;" href="https://github.com/dotkernel/admin/stargazers" target="_blank" rel="noopener noreferrer"><img title="GitHub stars" src="https://img.shields.io/github/stars/dotkernel/admin" class="img-fluid rounded my-2"></a><img style="display: inline-block;" title="PHP from Packagist (specify version)" src="https://img.shields.io/packagist/php-v/dotkernel/admin/3.0.0" class="img-fluid rounded my-2"><img style="display: inline-block;" title="Packagist Version" src="https://img.shields.io/packagist/v/dotkernel/admin" class="img-fluid rounded my-2"> <a style="display: inline-block;" href="https://github.com/dotkernel/admin/blob/3.0/LICENSE.md" target="_blank" rel="noopener noreferrer"><img title="GitHub License" src="https://img.shields.io/github/license/dotkernel/frontend" class="img-fluid rounded my-2"></a><!-- /wp:paragraph --></p>
<p class="mb-3"><!-- wp:paragraph --></p>
<p class="mb-3">Dotkernel is a Collection of PSR-7 Middleware applications built on top of <a href="https://getlaminas.org/" target="_blank" rel="noreferrer noopener">Mezzio microframework and using Laminas components</a></p>
<p class="mb-3"><!-- /wp:paragraph --></p>
<p class="mb-3"><!-- wp:paragraph --></p>
<p class="mb-3">&nbsp;Dotkernel Admin is a basic admin panel, based on Boostrap ^4.5.0 , using Doctrine and performing basic CRUD operations over a database. <br></p>
<p class="mb-3"><!-- /wp:paragraph --></p>
<p class="mb-3"><!-- wp:paragraph --></p>
<p class="mb-3">You can <strong>clone </strong>it from <a href="https://github.com/dotkernel/admin" target="_blank" rel="noreferrer noopener">github </a></p>
<p class="mb-3"><!-- /wp:paragraph --></p>
<p class="mb-3"><!-- wp:paragraph --></p>
<p class="mb-3"><strong>Live demo:</strong> <a href="https://admin.dotkernel.net" target="_blank" rel="noreferrer noopener">admin.dotkernel.net</a></p>
<p class="mb-3"><!-- /wp:paragraph --></p>
<p class="mb-3"><!-- wp:heading {"level":5} --></p>
<h5>Changelog:</h5>
<p class="mb-3"><!-- /wp:heading --></p>
<p class="mb-3"><!-- wp:paragraph --></p>
<p class="mb-3"><em>Branch 3.0 is the current and default branch </em>, and :</p>
<p class="mb-3"><!-- /wp:paragraph --></p>
<p class="mb-3"><!-- wp:list --></p>
<ul>
<li>Require <strong>Mezzio</strong> <strong>^3.2</strong></li>
<li>Require <strong>PHP ^7.4</strong></li>
<li>Require <strong>Doctrine 2.7.x</strong></li>
<li>Require <strong>Twig 3.x</strong></li><li>Require <b>Bootstrap </b>4.5</li>
<li>Limited dot-* packages to version <strong>3.x</strong> and above</li>
</ul>
<p class="mb-3"><!-- /wp:list --></p>
<p class="mb-3"><!-- wp:paragraph --></p>
<p class="mb-3">&nbsp;</p>
<p class="mb-3"><!-- /wp:paragraph --></p>
<p class="mb-3"><!-- wp:paragraph --></p>
<p class="mb-3">&nbsp;</p>
<p class="mb-3"><!-- /wp:paragraph --></p>
                    </section>
                </article>
            </main>
            
        </div>
    </div>
{% endblock %}