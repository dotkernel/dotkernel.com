{% extends '@layout/default.html.twig' %}

{% block title %}PHP 8.3 support in Dotkernel Admin{% endblock %}

{% block page_title %}
    <div class="mb-2 text-uppercase small fw-bold text-primary tracking-wider">Dotkernel 3</div>
    <h1 class="fw-bold text-dark display-6 mb-0">PHP 8.3 support in Dotkernel Admin</h1>
    <hr class="mt-4 mb-2 opacity-25">
{% endblock %}

{% block content %}
<!-- wp:paragraph -->
<p>With the release of <strong>PHP 8.3</strong>, the DotKernel team has been working on updating the dependencies in our packages. Eventually, this allowed us to update our Applications as well, starting with the <a href="https://github.com/dotkernel/admin" data-type="link" data-id="https://github.com/dotkernel/admin" target="_blank" rel="noreferrer noopener">Admin</a>, in release <strong>4.3.1</strong></p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p>There were some issues and backward incompatibilities that we will list below.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p>The full list of file changes is <a href="https://github.com/dotkernel/admin/pull/218/files" data-type="link" data-id="https://github.com/dotkernel/admin/pull/218/files" target="_blank" rel="noreferrer noopener">here</a>.</p>
<!-- /wp:paragraph -->

<!-- wp:list -->
<ul><!-- wp:list-item -->
<li><strong>Supports only PHP 8.2 and PHP 8.3</strong><!-- wp:list -->
<ul><!-- wp:list-item -->
<li>Removed support for PHP 8.1</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
