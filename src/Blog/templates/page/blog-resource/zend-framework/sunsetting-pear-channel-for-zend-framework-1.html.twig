{% extends '@layout/default.html.twig' %}

{% block title %}Sunsetting PEAR Channel for Zend Framework 1{% endblock %}

{% block page_title %}
    <div class="mb-2 text-uppercase small fw-bold text-primary tracking-wider">Zend Framework</div>
    <h1 class="fw-bold text-dark display-6 mb-0">Sunsetting PEAR Channel for Zend Framework 1</h1>
    <hr class="mt-4 mb-2 opacity-25">
{% endblock %}

{% block content %}
    <div class="container py-4">
        <div class="row g-4">
            
            {% include '@partial/left-menu.html.twig' %}

            <main class="col-12 col-md-8 col-lg-9">
                <article class="card border-0 shadow-sm p-4 p-md-5 h-100">
                    <header class="mb-4">
                        <h1 class="h2 text-dark fw-bold">Sunsetting PEAR Channel for Zend Framework 1</h1>
                        <div class="text-muted small">
                            <i class="bi bi-folder2-open me-1"></i> Zend Framework
                        </div>
                    </header>

                    <section class="post-content text-secondary lh-lg fs-6">
                        <!-- wp:heading -->
<h2>Sunsetting PEAR Channel for Zend Framework 1</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p class="mb-3">The unofficial <a rel="noreferrer noopener" href="http://pear.dotkernel.com/" data-type="URL" data-id="http://pear.dotkernel.com/" target="_blank"><strong>PEAR channel for Zend Framework 1</strong> </a> was created in <a rel="noreferrer noopener" href="https://www.dotkernel.com/dotkernel/migration-of-zend-framework-1-pear-channel/" data-type="URL" data-id="https://www.dotkernel.com/dotkernel/migration-of-zend-framework-1-pear-channel/" target="_blank">2016</a> , at the time when <a rel="noreferrer noopener" href="https://pear.php.net/" data-type="URL" data-id="https://pear.php.net/" target="_blank">PEAR</a> was still used a lot.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3"></p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">Due to the fact that is a pain to upgrade <strong>PEAR </strong>to work with <strong>PHP 8</strong> , we must sunset the channel .</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">Another reason for sunsetting is that currently is running on an LXC container with Centos 7 , which does not work on latest Proxmox version, and the upgrade to Amlaminux is too much of a pain.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3"></p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">Thank you PEAR  for your contribution to PHP ecosystem, it was a major part of <strong>PHP </strong>infrastructure .</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3"></p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3"></p>
<!-- /wp:paragraph -->
                    </section>
                </article>
            </main>
            
        </div>
    </div>
{% endblock %}