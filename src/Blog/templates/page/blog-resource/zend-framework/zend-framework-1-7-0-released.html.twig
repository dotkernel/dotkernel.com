{% extends '@layout/default.html.twig' %}
{% block json_ld %} {{ include('@jsonld/zend-framework/zend-framework-1-7-0-released.jsonld.twig') }} {% endblock %}

{% block title %}Zend Framework 1.7.0 Released{% endblock %}

{% block page_title %}
    <div class="wrap">
        <div class="post-hero">
            <a href="{{ url('page::blog') }}" class="breadcrumb-back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                Back to Blog
            </a>
            <div><span class="eyebrow">Zend Framework</span></div>
            <h1>{{ article.title }}</h1>
            <div class="post-meta">
                <span class="text-muted small">
                    By <a href="{{ path('page::author-resource', {slug: article.author.slug}) }}" class="fw-bold link-dark text-decoration-none">{{ article.author.name }}</a>
                    &nbsp;.&nbsp; {{ article.postDate|date('M d, Y') }}
                </span>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="wrap post-body-wrap">
        <div class="post-layout">

            {{ include('@partial/left-menu.html.twig') }}

            <article class="article">
                <div class="entry">
At first glance , the biggest news is AMF support:

<a title="Zend Framework AMF" href="http://framework.zend.com/manual/1.12/en/zend.amf.server.html" target="_blank" rel="noopener noreferrer">Adobe's Action Message Format protocol to your PHP 5 application</a>

<a href="http://framework.zend.com/download/latest" target="_blank" rel="noopener noreferrer">Download latest  ZF </a>
                </div>

                {{ include('@partial/post-nav.html.twig') }}
            </article>

        </div>
    </div>
{% endblock %}
