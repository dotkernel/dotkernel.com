{% extends '@layout/default.html.twig' %}

{% block title %}Zend Framework 1.7.0 Released{% endblock %}

{% block page_title %}
    <div class="mb-2 text-uppercase small fw-bold text-primary tracking-wider">Zend Framework</div>
    <h1 class="fw-bold text-dark display-6 mb-0">Zend Framework 1.7.0 Released</h1>
    <hr class="mt-4 mb-2 opacity-25">
{% endblock %}

{% block content %}
    <div class="container py-4">
        <div class="row g-4">

            {{ include('@partial/left-menu.html.twig') }}

            <main class="col-12 col-md-8 col-lg-9">
                <article class="card border-0 shadow-sm p-4 p-md-5 h-100">
                    <header class="mb-4">
                        <h1 class="h2 text-dark fw-bold">Zend Framework 1.7.0 Released</h1>
                        <div class="text-muted small">
                            <i class="bi bi-folder2-open me-1"></i> Zend Framework
                        </div>
                    </header>

                    <section class="post-content text-secondary lh-lg fs-6">
                        At first glance , the biggest news is AMF support:

<a title="Zend Framework AMF" href="http://framework.zend.com/manual/1.12/en/zend.amf.server.html" target="_blank" rel="noopener noreferrer">Adobe's Action Message Format protocol to your PHP 5 application</a>

<a href="http://framework.zend.com/download/latest" target="_blank" rel="noopener noreferrer">Download latest  ZF </a>
                    </section>
                </article>
            </main>

        </div>
    </div>
{% endblock %}
