{% extends '@layout/default.html.twig' %}
{% block json_ld %} {% include '@jsonld/zend-framework/scienta-zf-debug-bar-a-very-helpfull-zf-debug-tool.jsonld.twig'%} {% endblock %}

{% block title %}Scienta ZF Debug Bar: A very helpfull ZF debug tool{% endblock %}

{% block page_title %}
    <div class="wrap">
        <div class="post-hero">
            <a href="{{ url('page::blog') }}" class="breadcrumb-back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                Back to Blog
            </a>
            <div><span class="eyebrow">Zend Framework</span></div>
            <h1>{{ article.title }}</h1>
            <div class="post-meta">
                <span class="text-muted small">
                    By <a href="{{ path('page::author-resource', {slug: article.author.slug}) }}" class="fw-bold link-dark text-decoration-none">{{ article.author.name }}</a>
                    &nbsp;.&nbsp; {{ article.postDate|date('M d, Y') }}
                </span>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="wrap post-body-wrap">
        <div class="post-layout">

            {{ include('@partial/left-menu.html.twig') }}

            <article class="article">
                <div class="entry">
Just found today a very interesting and helpful debug tool:

<strong><a title="Scienta ZF Debug Bar" href="http://jokke.dk/software/scientadebugbar" target="_blank" rel="noopener noreferrer">Scienta</a></strong>

We at DotKernel used some very basic debug bar:  queries, time spent , memory used.  But this <strong>Scienta</strong> is way more complex and nicer then our internal code,  so we switch to it and integrate it in DotKernel code base.
                </div>

                {{ include('@partial/post-nav.html.twig') }}
            </article>

        </div>
    </div>
{% endblock %}
