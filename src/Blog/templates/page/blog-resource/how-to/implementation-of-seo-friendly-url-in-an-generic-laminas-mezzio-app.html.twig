{% extends '@layout/default.html.twig' %}

{% block title %}Implementation of SEO friendly URL in an generic Laminas Mezzio app{% endblock %}

{% block page_title %}
    <div class="mb-2 text-uppercase small fw-bold text-primary tracking-wider">How to's</div>
    <h1 class="fw-bold text-dark display-6 mb-0">Implementation of SEO friendly URL in an generic Laminas Mezzio app</h1>
    <hr class="mt-4 mb-2 opacity-25">
{% endblock %}

{% block content %}
    <div class="container py-4">
        <div class="row g-4">

            {{ include('@partial/left-menu.html.twig') }}

            <main class="col-12 col-md-8 col-lg-9">
                <article class="card border-0 shadow-sm p-4 p-md-5 h-100">
                    <header class="mb-4">
                        <h1 class="h2 text-dark fw-bold">Implementation of SEO friendly URL in an generic Laminas Mezzio app</h1>
                        <div class="text-muted small">
                            <i class="bi bi-folder2-open me-1"></i> How to's
                        </div>
                    </header>

                    <section class="post-content text-secondary lh-lg fs-6">
                        <!-- wp:paragraph -->
<p class="mb-3"><strong>Prerequisites:</strong></p>
<!-- /wp:paragraph -->

<!-- wp:list -->
<ul><!-- wp:list-item -->
<li><a href="https://docs.mezzio.dev/" data-type="URL" data-id="https://docs.mezzio.dev/" target="_blank" rel="noreferrer noopener">Mezzio App</a></li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li><a href="https://www.doctrine-project.org/" data-type="URL" data-id="https://www.doctrine-project.org/" target="_blank" rel="noreferrer noopener">Doctrine</a></li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:paragraph -->
<p class="mb-3">In the vast digital landscape of the internet, where websites compete for attention, having a well-crafted URL can make a significant difference. By incorporating human-readable slugs into website URLs, we can enhance user experience, improve search engine optimization (SEO), and foster better engagement. In this article, we discuss the importance, benefits and how to implement human-readable URLs.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">The first 3 reasons why we should consider implementing slugs:</p>
<!-- /wp:paragraph -->

<!-- wp:list -->
<ul><!-- wp:list-item -->
<li>Readability and User-Friendly Experience</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Search Engine Optimization (SEO)</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Shareability and Trustworthiness</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:heading {"level":4} -->
<h4 class="wp-block-heading">How to implement slugs into Dotkernel, a practical example:</h4>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p class="mb-3">Let's consider we want to implement a feature that gives users the possibility to view other user's profile.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">When viewing another user's profile we have this URL: <strong>website.com/user/11</strong> and this doesn't look so appealing, am I right? </p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">So, the solution is to format the URL in a human-readable way, like this : <strong><strong>website.com/user/</strong>john-doe</strong>.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">To implement slugs into our codebase we are going to use a popular package, <a href="https://packagist.org/packages/gedmo/doctrine-extensions" data-type="URL" data-id="https://packagist.org/packages/gedmo/doctrine-extensions" target="_blank" rel="noreferrer noopener">gedmo/doctrine-extensions</a>.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">First, we need to install the package via composer by running : </p>
<!-- /wp:paragraph -->

<!-- wp:code -->
<pre class="wp-block-code"><code>composer require gedmo/doctrine-extensions</code></pre>
<!-- /wp:code -->

<!-- wp:paragraph -->
<p class="mb-3">After installing, we need to register the package's event listener into doctrine.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">To do this, add the following codeblock in your doctrine global configuration. In our case it would be in the <strong>doctrine.global.php</strong> file.</p>
<!-- /wp:paragraph -->

<!-- wp:code -->
<pre class="wp-block-code"><code>'doctrine' =&gt; &#91;
    'event_manager' =&gt; &#91;
        'orm_default' =&gt; &#91;
            'subscribers' =&gt; &#91;
                Gedmo\Sluggable\SluggableListener::class,
            ]
        ]
    ],
]</code></pre>
<!-- /wp:code -->

<!-- wp:paragraph -->
<p class="mb-3">This is all the configuration you will need, the next step is to create a new database column that will be our slug, we will add the column in the <strong>src/User/src/Entity/User.php</strong> entity and run the migrations. </p>
<!-- /wp:paragraph -->

<!-- wp:code -->
<pre class="wp-block-code"><code>use Gedmo\Mapping\Annotation as Gedmo;

...

/**
 * @ORM\Column(name="identity", type="string", length=64, nullable=false, unique=true)
 */
protected string $identity;

/**
 * @ORM\Column(name="slug", type="string", length=64, nullable=false, unique=true)
 * @Gedmo\Slug(fields={"identity"})
 */
protected string $slug;</code></pre>
<!-- /wp:code -->

<!-- wp:paragraph -->
<p class="mb-3">When generating the slug we can specify what field(s) to be used, in our case the slug will be generated using the 'identity' field, more details here.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">Now you can create a new user and see that the slug column was autocompleted.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">To wrap things up, human-readable URL's are a must nowadays, thanks to its swift implementation and multiple benefits.</p>
<!-- /wp:paragraph -->
                    </section>
                </article>
            </main>

        </div>
    </div>
{% endblock %}
