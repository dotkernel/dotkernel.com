{% extends '@layout/default.html.twig' %}
{% block json_ld %} {{ include('@jsonld/architecture/request-lifecycle-for-a-mezzio-based-application.jsonld.twig') }} {% endblock %}

{% block title %}Request Lifecycle for a Mezzio-Based Application{% endblock %}

{% block page_title %}
    <div class="wrap">
        <div class="post-hero">
            <a href="{{ url('page::blog') }}" class="breadcrumb-back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                Back to Blog
            </a>
            <div><span class="eyebrow">Architecture</span></div>
            <h1>{{ article.title }}</h1>
            <div class="post-meta">
                <span class="text-muted small">
                    By <a href="{{ path('page::author-resource', {slug: article.author.slug}) }}" class="fw-bold link-dark text-decoration-none">{{ article.author.name }}</a>
                    &nbsp;.&nbsp; {{ article.postDate|date('M d, Y') }}
                </span>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="wrap post-body-wrap">
        <div class="post-layout">

            {{ include('@partial/left-menu.html.twig') }}

            <article class="article">
                <div class="entry">
<h3>Seamlessly Interconnected Middleware for Enterprise-Level Solutions</h3>

<p class="mb-3">The request lifecycle is the sequence of steps that happen from the moment a user makes an HTTP request until the server sends back a response. </p>

<p class="mb-3">The graph below shows how the request is handled by <strong>Dotkernel Light</strong> (<a href="https://github.com/dotkernel/light" data-type="link" data-id="https://github.com/dotkernel/light" target="_blank" rel="noreferrer noopener">GitHub</a>, <a href="https://docs.dotkernel.org/light-documentation/" data-type="link" data-id="https://docs.dotkernel.org/light-documentation/" target="_blank" rel="noreferrer noopener">documentation</a>), one of the applications in the <a href="https://github.com/dotkernel" data-type="link" data-id="https://github.com/dotkernel" target="_blank" rel="noreferrer noopener">Dotkernel Headless Platform suite</a>.</p>

<blockquote><p class="mb-3">Hover over items for description</p>
</blockquote>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

<style>
.section-block {
    margin: 0 0  70px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent linear-gradient(180deg, #F4F6FF 0%, #FFFFFF 100%) 0% 0% no-repeat padding-box;
    border-radius: 44px;
    padding: 20px;
}

.middleware-flow {
    width: 650px;
}
.middleware-flow .title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 24px;
    font-weight: bold;
    color: #003396;
    text-align: center;
    margin-bottom: 20px;
}

.entry-point {
    padding: 5px 24px 20px;
    border-radius: 16px;
    line-height: 1.6;
    font-size: 16px;
    background: #dce6ff;
    width: 650px;
}

.entry-point p {
    text-align: center;
    margin: 17px auto;
    font-weight: bold;
    max-width: 300px;
    line-height: 15px;
}

.entry-point .items {
    display: flex;
    justify-content: space-between;
    gap: 5px;
}

.entry-point .item {
    padding: 15px;
    border-radius: 16px;
    font-size: 14px;
    font-weight: bold;
    background: #cbd5ef;
    border-left: 4px solid #64748b;
}

.entry-point .item:hover {
    background: #dadfec;
}

.onion {
    position: relative;
    height: 450px;
    text-align: center;
}

.onion .layer {
    position: absolute;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border: 1px solid #b1b1b1;
}

.onion .tool-tip {
    padding: 10px;
    position: absolute;
    border-radius: 16px;
    top: 0;
    left: 62%;
    width: 245px;
    background: #dddff1db;
    border-left: 4px solid #64748b;
}

.onion .tool-tip .title {
    font-family: 'Barlow', sans-serif;
    font-size: 14px;
    font-weight: bold;
    color: #333;
    margin-bottom: 10px;
    text-align: left;
}

.onion .tool-tip .line {
    font-family: 'Barlow', sans-serif;
    font-size: 14px;
    margin-bottom: 10px;
    text-align: left;
}

.onion p {
    font-size: 14px;
    margin: auto;
    max-width: initial;
}

.onion .layer p {
    text-align: center;
    margin: 17px auto;
    font-weight: bold;
    max-width: 140px;
    line-height: 15px !important;
}

.onion .layer.layer1 {
    width: 450px;
    height: 450px;
    background-color: #ea8989;
    background-image: linear-gradient(to bottom right, #ffffff 0%, #ea9f9f 40%, #dd6a6a 80%, #531919 100%);
}

.onion .layer.layer1:hover {
    background-image: linear-gradient(to bottom right, #ffffff 0%, #efcbcb 40%, #dd6a6a 80%, #8f3636 100%);
}

.onion .layer.layer2 {
    width: 380px;
    height: 380px;
    background-color: #79e1da;
    background-image: linear-gradient(to bottom right, #ffffff 0%, #9de1dd 40%, #3aa396 80%, #13514d 100%);
    margin-top: 30px;
}

.onion .layer.layer2:hover {
    background-image: linear-gradient(to bottom right, #ffffff 0%, #c0efed 40%, #3aa396 80%, #328a85 100%);
}

.onion .layer.layer3 {
    width: 310px;
    height: 310px;
    background-color: #a9e1a7;
    background-image: linear-gradient(to bottom right, #ffffff 0%, #a9e1a7 40%, #55b151 80%, #1b5c19 100%);
    margin-top: 60px;
}

.onion .layer.layer3:hover {
    background-image: linear-gradient(to bottom right, #ffffff 0%, #c9eac8 40%, #79ca75 80%, #419a3f 100%);
}

.onion .layer.layer4 {
    width: 240px;
    height: 240px;
    background-color: #ffad5f;
    background-image: linear-gradient(to bottom right, #ffffff 0%, #efd0bc 40%, #d38d4a 80%, #af5e13 100%);
    margin-top: 90px;
}

.onion .layer.layer4:hover {
    background-image: linear-gradient(to bottom right, #ffffff 0%, #f1e4db 40%, #dcae80 80%, #ae7035 100%);
}

.onion .layer.layer5 {
    width: 170px;
    height: 170px;
    background-color: #f1e5c5;
    background-image: linear-gradient(to bottom right, #ffffff 0%, #e6dcc6 40%, #b69749 80%, #5e4415 100%);
    margin-top: 120px;
}

.onion .layer.layer5:hover {
    background-image: linear-gradient(to bottom right, #ffffff 0%, #f1eae4 40%, #b69749 80%, #816433 100%);
}

.onion .layer.layer6 {
    width: 100px;
    height: 100px;
    background-color: #d7c5f1;
    background-image: linear-gradient(to bottom right, #ffffff 0%, #cbc0e6 40%, #6239aa 80%, #451b80 100%);
    margin-top: 150px;
}

.onion .layer.layer6:hover {
    background-image: linear-gradient(to bottom right, #ffffff 0%, #dcd5ea 40%, #7f5dbd 80%, #6836ae 100%);
}

.onion .layer.layer6 p {
    margin-top: 30px;
}

.exit-point {
    padding: 5px 24px 20px;
    border-radius: 16px;
    line-height: 1.6;
    font-size: 16px;
    background: #e5f1e1;
    margin-top: 25px;
}

.exit-point p {
     text-align: center;
     margin: 17px auto;
     font-weight: bold;
     max-width: 300px;
     line-height: 15px;
 }

.exit-point .items {
    display: flex;
    justify-content: space-evenly;
    font-weight: bold;
}

.exit-point .item {
    padding: 15px;
    border-radius: 16px;
    max-width: 33%;
    background: #c8dfc4;
    border-left: 4px solid #47803f;
}

.exit-point .item:hover {
    background: #dce6d9;
}

.arrow-flow {
    position: absolute;
}

.arrow-center {
    left: 50%;
}

.arrow-offset1 {
    right: 120px;
    bottom: -25px;
}

.arrow-offset2 {
    right: 155px;
    bottom: -25px;
}

.arrow-offset3 {
    right: 190px;
    bottom: -25px;
}

.arrow-offset4 {
    right: 225px;
    bottom: -25px;
}

.arrow-offset5 {
    right: 260px;
    bottom: -25px;
}

.arrow1 {
    top: 50px;
}

.arrow2 {
    top: 115px;
}

.arrow3 {
    top: 180px;
}

.arrow4 {
    top: 245px;
}

.arrow5 {
    top: 310px;
}

.arrow-response {
    position: absolute;
    bottom: -25px;
    left: 50%;
}

.down-arrow {
    --arrow-length: 120px;
    --arrow-color: #333;
    --arrow-thickness: 2px;

    position: relative;
    width: var(--arrow-thickness);
    height: var(--arrow-length);
    background: var(--arrow-color);
    margin: 5px auto 15px;
}

.entry-point .down-arrow {
    margin: 10px auto 25px;
}

.down-arrow::after {
    content: "";
    position: absolute;
    bottom: -8px;
    left: 50%;
    width: 12px;
    height: 12px;
    border-right: var(--arrow-thickness) solid var(--arrow-color);
    border-bottom: var(--arrow-thickness) solid var(--arrow-color);
    transform: translateX(-50%) rotate(45deg);
}

.right-arrow {
    --arrow-length: 4px;
    --arrow-color: #333;
    --arrow-thickness: 10px;

    position: relative;
    width: var(--arrow-thickness);
    height: var(--arrow-length);
    background: var(--arrow-color);
    margin: 40px 13px 0 0;
}

.right-arrow::after {
    content: "";
    position: absolute;
    bottom: -6px;
    right: 0;
    width: 16px;
    height: 16px;
    border-right: var(--arrow-length) solid var(--arrow-color);
    border-bottom: var(--arrow-length) solid var(--arrow-color);
    transform: translateX(80%) rotate(-45deg);
}

.arrow-15 {
    --arrow-length: 15px;
}

.arrow-20 {
    --arrow-length: 20px;
}

.arrow-40 {
    --arrow-length: 40px;
}

.arrow-170 {
    --arrow-length: 170px;
}

.arrow-95 {
    --arrow-length: 95px;
    --arrow-thickness: 1px;
}

.arrow-125 {
    --arrow-length: 125px;
    --arrow-thickness: 1px;
}

.arrow-155 {
    --arrow-length: 155px;
    --arrow-thickness: 1px;
}

.arrow-185 {
    --arrow-length: 185px;
    --arrow-thickness: 1px;
}

.arrow-215 {
    --arrow-length: 215px;
    --arrow-thickness: 1px;
}
</style>
                <div class="middleware-flow">
                    <div class="entry-point">
                        <p class="mb-3">Entry Point</p>
                        <div class="items">
                            <div class="item hasTooltip"
                                 data-tooltipTitle="1. HTTP Request "
                                 data-tooltipLine1="Bootstrap the application, load configuration and create the Mezzio application instance.">
                                1. HTTP Request<br>
                            </div>
                            <div class="item hasTooltip"
                                 data-tooltipTitle="2. Service Container"
                                 data-tooltipLine1="Register factories, aliases and delegators. All services are configured and ready to use.">
                                2. Service Container
                            </div>
                            <div class="item hasTooltip"
                                 data-tooltipTitle="3. Route Registration"
                                 data-tooltipLine1="Read all available routes with their allowed request methods and dynamically register them in the application. Routes are managed by FastRoute."
                                 data-tooltipLine2="&lt;strong&gt;Example:&lt;/strong&gt; /page/about -&gt; GetPageViewHandler&lt;br&gt;&lt;strong&gt;Method:&lt;/strong&gt; GET&lt;br&gt;&lt;strong&gt;Route name:&lt;/strong&gt; page::about">
                                3. Route Registration
                            </div>
                            <div class="item hasTooltip"
                                 data-tooltipTitle="4. Middleware Pipeline "
                                 data-tooltipLine1="Loads the predefined order of middleware. It defines how incoming HTTP requests move through the application and how responses are generated.">
                                4. Middleware Pipeline<br>
                            </div>
                        </div>
                    </div>
                    <div class="down-arrow arrow-20"></div>
                    <div class="onion">
                        <div class="layer layer1 hasTooltip"
                            data-tooltipTitle="5. Routing"
                            data-tooltipLine1="FastRoute matches the URL and method against registered routes."
                            data-tooltipLine2="&lt;strong&gt;Match:&lt;/strong&gt; GET /page/about&lt;br&gt;
                                &lt;strong&gt;Handler:&lt;/strong&gt; GetPageViewHandler&lt;br&gt;
                                &lt;strong&gt;Route name:&lt;/strong&gt; page::about">
                            <p class="mb-3">5. Routing</p>
                        </div>
                        <div class="layer layer2 hasTooltip"
                             data-tooltipTitle="6. Handler Invocation"
                             data-tooltipLine1="Extract the matched route name from the request and pass it to the renderer."
                             data-tooltipLine2="$template = $request-&gt; getAttribute(RouteResult::class)-&gt; getMatchedRouteName();&lt;br&gt;// $template = 'page::about';">
                            <p class="mb-3">6. Handler<br>Invocation</p>
                        </div>
                        <div class="arrow-flow arrow-center arrow1">
                            <div class="down-arrow arrow-15"></div>
                        </div>
                        <div class="arrow-flow arrow-offset1">
                            <div class="down-arrow arrow-215"></div>
                        </div>
                        <div class="layer layer3 hasTooltip"
                             data-tooltipTitle="7. Custom Logic Execution in Handler"
                             data-tooltipLine1="Execute the business logic in the handler. The process can involve services and any custom logic.">
                            <p class="mb-3">7. Custom Logic<br>Execution in Handler</p>
                        </div>
                        <div class="arrow-flow arrow-center arrow2">
                            <div class="down-arrow arrow-15"></div>
                        </div>
                        <div class="arrow-flow arrow-offset2">
                            <div class="down-arrow arrow-185"></div>
                        </div>
                        <div class="layer layer4 hasTooltip"
                             data-tooltipTitle="8. Template Rendering"
                             data-tooltipLine1="Twig loads the template, applies layout, renders blocks and includes partials."
                             data-tooltipLine2="&lt;strong&gt;Load:&lt;/strong&gt; src/Page/templates/page/about.html.twig&lt;br&gt;
                                &lt;strong&gt;Extends:&lt;/strong&gt; @layout/default.html.twig&lt;br&gt;
                                &lt;strong&gt;Render blocks:&lt;/strong&gt; title, content&lt;br&gt;
                                &lt;strong&gt;Include partials:&lt;/strong&gt; alerts.html.twig, etc.&lt;br&gt;
                                &lt;strong&gt;Output:&lt;/strong&gt; Final HTML">
                            <p class="mb-3">8. Template<br>Rendering </p>
                        </div>
                        <div class="arrow-flow arrow-center arrow3">
                            <div class="down-arrow arrow-15"></div>
                        </div>
                        <div class="arrow-flow arrow-offset3">
                            <div class="down-arrow arrow-155"></div>
                        </div>
                        <div class="layer layer5 hasTooltip"
                             data-tooltipTitle="9. Response Creation"
                             data-tooltipLine1="An HtmlResponse is created with status, headers and the rendered HTML body."
                             data-tooltipLine2="&lt;strong&gt;Status:&lt;/strong&gt; 200 OK&lt;br&gt;&lt;strong&gt;Content-Type:&lt;/strong&gt; text/html; charset=utf-8&lt;br&gt;&lt;strong&gt;Body:&lt;/strong&gt; Rendered HTML">
                            <p class="mb-3">9. Response<br>Creation</p>
                        </div>
                        <div class="arrow-flow arrow-center arrow4">
                            <div class="down-arrow arrow-15"></div>
                        </div>
                        <div class="arrow-flow arrow-offset4">
                            <div class="down-arrow arrow-125"></div>
                        </div>
                        <div class="layer layer6 hasTooltip"
                             data-tooltipTitle="10. Response Pipeline"
                             data-tooltipLine1="The response flows back through the middleware stack. Middleware can modify headers, cookies, compress content, etc.">
                            <p class="mb-3">10. Response<br>Pipeline</p>
                        </div>
                        <div class="arrow-flow arrow-center arrow5">
                            <div class="down-arrow arrow-15"></div>
                        </div>
                        <div class="arrow-flow arrow-offset5">
                            <div class="down-arrow arrow-95"></div>
                        </div>
                        <div class="arrow-response">
                            <div class="down-arrow arrow-40"></div>
                        </div>
                        <div class="tool-tip" id="tool-tip" style="display: none">
                            <div id="tool-tip-title" class="title">asd</div>
                            <div id="tool-tip-line1" class="line">asd</div>
                            <div id="tool-tip-line2" class="line">asd</div>
                        </div>
                    </div>
                    <div class="exit-point hasTooltip"
                         data-tooltipTitle="11. Response Emitter"
                         data-tooltipLine1="The final response is sent back to the browser. The page is rendered and sent to the user.">
                        <p class="mb-3">11. Response Emitter</p>
                        <div class="items">
                            <div class="item">
                                <div>HTTP 20x, 30x</div>
                            </div>
                            <div class="item">
                                <div>HTTP 40x</div>
                            </div>
                            <div class="item">
                                <div>HTTP 50x</div>
                            </div>
                        </div>
                    </div>
                </div>

<script>
$('.hasTooltip').hover(
    function() {
        $('#tool-tip').show();
        $('#tool-tip-title').text($(this).dataset.tooltiptitle);
        $('#tool-tip-line1').text($(this).dataset.tooltipline1);
        if ($(this).dataset.tooltipline2) {
            $('#tool-tip-line2').html($(this).dataset.tooltipline2);
        }
    },
    function() {
        $('#tool-tip').hide();
        $('#tool-tip-title').text('');
        $('#tool-tip-line1').text('');
        $('#tool-tip-line2').text('');
    }
);
</script>

<p class="mb-3"></p>
                </div>

                {{ include('@partial/post-nav.html.twig') }}
            </article>

        </div>
    </div>
{% endblock %}
