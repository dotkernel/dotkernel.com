{% extends '@layout/default.html.twig' %}

{% block title %}Code Quality: How to setup phpcs in PHPStorm{% endblock %}

{% block page_title %}
    <div class="mb-2 text-uppercase small fw-bold text-primary tracking-wider">PHPStorm</div>
    <h1 class="fw-bold text-dark display-6 mb-0">Code Quality: How to setup phpcs in PHPStorm</h1>
    <hr class="mt-4 mb-2 opacity-25">
{% endblock %}

{% block content %}
<!-- wp:paragraph -->
<p>PHP_CodeSniffer or phpcs is a tool that helps developers maintain a specific standard in the way they write code. In order to be able to provide relevant information, phpcs needs to be configured correctly in PHPStorm (see image).</p>
<!-- /wp:paragraph -->

<!-- wp:image {"id":6033,"sizeSlug":"full","linkDestination":"none"} -->
<figure class="wp-block-image size-full"><img src="https://www.dotkernel.com/wp-content/uploads/2023/12/image.png" alt="" class="wp-image-6033"/></figure>
<!-- /wp:image -->

<!-- wp:spacer {"height":"50px"} -->
<div style="height:50px" aria-hidden="true" class="wp-block-spacer"></div>
<!-- /wp:spacer -->

<!-- wp:paragraph -->
<p>Whether you just cloned or you are already working on a project, follow the below guide on how to prepare your environment.</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
<h2 class="wp-block-heading">When cloning a project</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p><strong>Step 1</strong>:</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><em>Windows Terminal</em>: Move to the directory where you want to clone the project</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><strong>Step 2</strong>:</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><em>Windows Terminal</em>: Clone the project</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><strong>Step 3</strong>:</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><em>PHPStorm</em>: install composer dependencies</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><strong>Step 4</strong>:</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><em>PHPStorm</em>: restart</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><strong>Step 5</strong>:</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><em>PHPStorm</em>: Open Settings (<em>FIle</em> -&gt; <em>Settings</em>) and go to <em>PHP</em> -&gt; <em>Quality Tools</em> -&gt; <em>PHP_CodeSniffer</em>:</p>
<!-- /wp:paragraph -->

<!-- wp:list -->
<ul><!-- wp:list-item -->
<li>Make sure that the inspection button is ON</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li><em>Coding standard</em> is set to <em>Custom</em> and the field next to it contains the path to your project's <em>phpcs.xml</em> file</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:heading -->
<h2 class="wp-block-heading">For an existing project</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p><strong>Step 1</strong>:</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><em>PHPStorm</em>: Open Settings (<em>FIle</em> -&gt; <em>Settings</em>) and go to <em>PHP</em> -&gt; <em>Quality Tools</em> -&gt; <em>PHP_CodeSniffer</em>. There, if <em>Coding standard</em> is set to <em>Custom</em> and the field next to it contains the path to your project's <em>phpcs.xml</em> file, then PHPStorm is configured correctly to use phpcs - NO need to continue with the next steps.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><strong>Step 2</strong>:</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><em>PHPStorm</em>: delete (if exists) the vendor directory</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><strong>Step 3</strong>:</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><em>PHPStorm</em>: install composer dependencies</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><strong>Step 4</strong>:</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><em>PHPStorm</em>: restart</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><strong>Step 5</strong>:</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p>Go to <strong>Step 1</strong>.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p>After you have the above configurations, you should start seeing information in the top-right corner of the editor.</p>
<!-- /wp:paragraph -->

<!-- wp:image {"id":6039,"sizeSlug":"large","linkDestination":"none"} -->
<figure class="wp-block-image size-large"><img src="https://www.dotkernel.com/wp-content/uploads/2023/12/image-1-1024x83.png" alt="" class="wp-image-6039"/></figure>
<!-- /wp:image -->

<!-- wp:paragraph -->
<p>Once the PHPStorm has finished analyzing the opened file, you should see either a green tick (meaning no errors)</p>
<!-- /wp:paragraph -->

<!-- wp:image {"id":6040,"sizeSlug":"large","linkDestination":"none"} -->
<figure class="wp-block-image size-large"><img src="https://www.dotkernel.com/wp-content/uploads/2023/12/image-2-1024x66.png" alt="" class="wp-image-6040"/></figure>
<!-- /wp:image -->

<!-- wp:paragraph -->
<p>or a count of all the errors, warnings, typos:</p>
<!-- /wp:paragraph -->

<!-- wp:image {"id":6041,"sizeSlug":"full","linkDestination":"none"} -->
<figure class="wp-block-image size-full"><img src="https://www.dotkernel.com/wp-content/uploads/2023/12/image-3.png" alt="" class="wp-image-6041"/></figure>
<!-- /wp:image -->

<!-- wp:paragraph -->
<p>Clicking on them will open a section where you get detailed information on each item, their location and recommendations on how to fix them:</p>
<!-- /wp:paragraph -->

<!-- wp:image {"id":6043,"sizeSlug":"full","linkDestination":"none"} -->
<figure class="wp-block-image size-full"><img src="https://www.dotkernel.com/wp-content/uploads/2023/12/image-5.png" alt="" class="wp-image-6043"/></figure>
<!-- /wp:image -->
{% endblock %}