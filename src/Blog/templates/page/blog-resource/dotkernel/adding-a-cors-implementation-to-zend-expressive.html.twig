{% extends '@layout/default.html.twig' %}

{% block title %}Adding a CORS implementation to Zend Expressive{% endblock %}

{% block page_title %}
    <div class="mb-2 text-uppercase small fw-bold text-primary tracking-wider">Dotkernel</div>
    <h1 class="fw-bold text-dark display-6 mb-0">Adding a CORS implementation to Zend Expressive</h1>
    <hr class="mt-4 mb-2 opacity-25">
{% endblock %}

{% block content %}
    <div class="container py-4">
        <div class="row g-4">

            {{ include('@partial/left-menu.html.twig') }}

            <main class="col-12 col-md-8 col-lg-9">
                <article class="card border-0 shadow-sm p-4 p-md-5 h-100">
                    <header class="mb-4">
                        <h1 class="h2 text-dark fw-bold">Adding a CORS implementation to Zend Expressive</h1>
                        <div class="text-muted small">
                            <i class="bi bi-folder2-open me-1"></i> Dotkernel
                        </div>
                    </header>

                    <section class="post-content text-secondary lh-lg fs-6">
                        <!-- wp:paragraph -->
<p class="mb-3">This article is a guide on how to add a CORS implementation on an existing DotKernel3 project.</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3} -->
<h3>The issue</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p class="mb-3">If you're facing this message:</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3"> "Access to XMLHttpRequest at ‘url’ has been blocked by cors policy. No ‘Access-Control-Allow-Origin header is present on the requested resource."</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">It means the server didn't sent the header that lets you access its data through a local client (eg.: browser).</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">This issue is most common when trying to get some data (usually json) that you want to process using JavaScript.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">The error looks similar to the image below:</p>
<!-- /wp:paragraph -->

<!-- wp:image {"align":"center","id":3521} -->
<div class="wp-block-image"><figure class="aligncenter"><img src="/uploads/2019/04/Screenshot-2019-04-06-at-15.03.21-1024x165-1-1024x165.png" alt="" class="wp-image-3521"/ class="img-fluid rounded my-2"></figure></div>
<!-- /wp:image -->

<!-- wp:heading -->
<h2>The solution</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p class="mb-3">A simple implementation would be using <a rel="noreferrer noopener" href="https://packagist.org/packages/tuupola/cors-middleware" target="_blank">Tuupola's Cors Middleware</a> package. </p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">This article was inspired by: <a href="https://akrabat.com/implementing-tuupola-cors-in-expressive/">https://akrabat.com/implementing-tuupola-cors-in-expressive/</a></p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":4} -->
<h4>Adding the package to your project</h4>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p class="mb-3">Run the following command in your project:</p>
<!-- /wp:paragraph -->

<!-- wp:preformatted -->
<pre class="wp-block-preformatted">composer require tuupola/cors-middleware</pre>
<!-- /wp:preformatted -->

<!-- wp:paragraph -->
<p class="mb-3">At the time writing this article the current package version is: 0.9.4.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">Follow the next steps to get your Zend Expressive or DotKernel3 project <strong>CORS friendly</strong>.</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":4} -->
<h4>Create the CORS config file</h4>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p class="mb-3">Create a <strong>cors.global.php</strong> file in the config/autoload directory.</p>
<!-- /wp:paragraph -->

<!-- wp:preformatted -->
<pre class="wp-block-preformatted">return ,<br>        "methods" =&gt; ,<br>        "headers.allow" =&gt; ,<br>        "headers.expose" =&gt; [],<br>        "credentials" =&gt; false,<br>        "cache" =&gt; 0,<br>    ],<br>    'dependencies' =&gt; ,<br>];<br></pre>
<!-- /wp:preformatted -->

<!-- wp:paragraph -->
<p class="mb-3">We'll come back at this file to register the CORS middleware.</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":4} -->
<h4>Creating a factory for the middleware</h4>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p class="mb-3">The factory should look like the one below.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">The code below extracts de config from the <strong>cors</strong> key if provided or initializes an empty array and instantiates the <strong>Tuupola CORS middleware</strong>.</p>
<!-- /wp:paragraph -->

<!-- wp:code -->
<pre class="wp-block-code"><code>&lt;?php

namespace App\Cors;

use Tuupola\Middleware\CorsMiddleware;

class CorsMiddlewareFactory
{
    public function __invoke($container)
    {
        $corsConfig = $container-&gt;get('config')&#91;'cors'] ?? &#91;];
        return new CorsMiddleware($corsConfig);
    }
}</code></pre>
<!-- /wp:code -->

<!-- wp:heading {"level":4} -->
<h4>Registering the CORS middleware </h4>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p class="mb-3">Back at <strong>cors.global.php</strong> we will register the cors middleware so our custom implemented factory will be used to create the middleware. (basic config example below)</p>
<!-- /wp:paragraph -->

<!-- wp:preformatted -->
<pre class="wp-block-preformatted">&lt;?php<br><br>use App\Cors\CorsMiddlewareFactory;<br>use Tuupola\Middleware\CorsMiddleware;<br><br>return ,<br>        "methods" =&gt; ,<br>        "headers.allow" =&gt; ,<br>        "headers.expose" =&gt; [],<br>        "credentials" =&gt; false,<br>        "cache" =&gt; 0,<br>    ],<br>    'dependencies' =&gt; <br>    ]<br>];<br></pre>
<!-- /wp:preformatted -->

<!-- wp:heading {"level":4} -->
<h4>Final step: Adding (registering) the CorsMiddleware in the pipeline</h4>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p class="mb-3">In this last step we only need to add the CorsMiddleware in config/pipelines.php</p>
<!-- /wp:paragraph -->

<!-- wp:code -->
<pre class="wp-block-code"><code>// don't forget the use statement
use Tuupola\Middleware\CorsMiddleware;

return function (Application $app, MiddlewareFactory $factory, ContainerInterface $container) : void {
    // ...
    $app-&gt;pipe(CorsMiddleware::class);
    // ...
};</code></pre>
<!-- /wp:code -->

<!-- wp:paragraph -->
<p class="mb-3">Add the cors middleware <strong>after</strong> the Error handler and <strong>before</strong> the middleware providing the data you want to access to make sure everything runs smoothly.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">This should get your project working with CORS. </p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3"></p>
<!-- /wp:paragraph -->
                    </section>
                </article>
            </main>

        </div>
    </div>
{% endblock %}
