{% extends '@layout/default.html.twig' %}
{% block json_ld %} {{ include('@jsonld/dotkernel/dotkernel-1-8-1-upgrade-from-1-8-0-released.jsonld.twig') }} {% endblock %}

{% block title %}DotKernel 1.8.1 + Upgrade from 1.8.0 Released{% endblock %}

{% block page_title %}
    <div class="wrap">
        <div class="post-hero">
            <a href="{{ url('page::blog') }}" class="breadcrumb-back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                Back to Blog
            </a>
            <div><span class="eyebrow">Dotkernel</span></div>
            <h1>{{ article.title }}</h1>
            <div class="post-meta">
                <span class="text-muted small">
                    By <a href="{{ path('page::author-resource', {slug: article.author.slug}) }}" class="fw-bold link-dark text-decoration-none">{{ article.author.name }}</a>
                    &nbsp;.&nbsp; {{ article.postDate|date('M d, Y') }}
                </span>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="wrap post-body-wrap">
        <div class="post-layout">

            {{ include('@partial/left-menu.html.twig') }}

            <article class="article">
                <div class="entry">
DotKernel 1.8.1 was just released.

Changes to DotKernel in the latest release:
- Enhanced Cache Support, which means you can use tags in your cache system if the host suports it

Here are some useful download links:

<a href="http://www.dotkernel.com/download/?did=42" target="_blank" rel="noopener noreferrer">DotKernel 1.8.1</a>

<a href="http://www.dotkernel.com/download/?did=43" target="_blank" rel="noopener noreferrer">Upgrade from DotKernel 1.8.0</a>

<a href="http://www.dotkernel.com/download/?did=41" target="_blank" rel="noopener noreferrer">DotKernel 1.8.0 (LTS)</a>

<h2 id="user-content-faq">Frequently Asked Questions</h2>

<div class="faq-list">
    <details class="acc" open>
        <summary>What's new in DotKernel 1.8.1? <span class="chev">+</span></summary>
        <div class="acc-body">
            <p class="mb-0">The main change is Enhanced Cache Support, which means you can use tags in your cache system if the host supports it.</p>
        </div>
    </details>
    <details class="acc">
        <summary>How do I upgrade from 1.8.0 to 1.8.1? <span class="chev">+</span></summary>
        <div class="acc-body">
            <p class="mb-0">The post provides a dedicated "Upgrade from DotKernel 1.8.0" download link, separate from the full DotKernel 1.8.1 package and the original DotKernel 1.8.0 (LTS) download.</p>
        </div>
    </details>
</div>
                </div>

                {{ include('@partial/post-nav.html.twig') }}
            </article>

        </div>
    </div>
{% endblock %}
