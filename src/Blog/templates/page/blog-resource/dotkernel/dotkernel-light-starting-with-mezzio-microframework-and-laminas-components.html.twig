{% extends '@layout/default.html.twig' %}

{% block title %}Dotkernel Light - Starting with Mezzio microframework and Laminas components{% endblock %}

{% block page_title %}
    <div class="mb-2 text-uppercase small fw-bold text-primary tracking-wider">Dotkernel</div>
    <h1 class="fw-bold text-dark display-6 mb-0">Dotkernel Light - Starting with Mezzio microframework and Laminas components</h1>
    <hr class="mt-4 mb-2 opacity-25">
{% endblock %}

{% block content %}
    <div class="container py-4">
        <div class="row g-4">

            {{ include('@partial/left-menu.html.twig') }}

            <main class="col-12 col-md-8 col-lg-9">
                <article class="card border-0 shadow-sm p-4 p-md-5 h-100">
                    <header class="mb-4">
                        <h1 class="h2 text-dark fw-bold">Dotkernel Light - Starting with Mezzio microframework and Laminas components</h1>
                        <div class="text-muted small">
                            <i class="bi bi-folder2-open me-1"></i> Dotkernel
                        </div>
                    </header>

                    <section class="post-content text-secondary lh-lg fs-6">
                        <!-- wp:paragraph -->
<p class="mb-3"><strong>Dotkernel Light</strong> is a version of Dotkernel Frontend that includes only the bare-bones essentials. Though simpler, it's perfect for:</p>
<!-- /wp:paragraph -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>A presentation site,</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>An introduction into the Mezzio microframework architecture,</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>A starting point for a more complex project where you have full control over functionality.</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:heading -->
<h2 class="wp-block-heading"><a href="#goal"></a>Goal</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p class="mb-3"><strong>Dotkernel Light </strong>is designed at the same time to be a fast-start example of using <strong>Mezzio microframework</strong>, as well as of using an <strong>entry-level version</strong> of Dotkernel Frontend. Primarily, its purpose is to present the <strong>noobie developer</strong> with as few moving parts as possible. It's also a perfect starting point for the more <strong>advanced developer</strong> who wants full control of the platform's functionality.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">Light retains the modern architecture of <strong>Mezzio microframework</strong> and several <strong>Laminas components</strong> used in Dotkernel Frontend. The low number of out-of-box components <strong>encourages the active exploration of functionality</strong> required by your application. Basically, you add only the packages your application needs.</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
<h2 class="wp-block-heading"><a href="#components-and-functionality"></a>Components and functionality</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p class="mb-3">We designed Dotkernel Light to be a stripped-down version of Dotkernel Frontend. Just like Dotkernel Frontend, Dotkernel Light is built on top of Mezzio microframework using Laminas components. The big difference is the limited features and thus lower number of packages. This makes the <strong>learning curve</strong> of working with the repo considerably gentler.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p class="mb-3">Currently, Light contains this <strong>functionality</strong>:</p>
<!-- /wp:paragraph -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>Routing</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Templating</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Error handling</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Tests and code quality checks</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:paragraph -->
<p class="mb-3">Compared to Frontend, Light had these <strong>items removed</strong>:</p>
<!-- /wp:paragraph -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>Doctrine and all database related stuff</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Sessions/Cookies/Flash messages</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Authentication/Authorization</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Dependency Injection</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Mail related stuff</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Navigation</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>CORS</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Forms/Validators/InputFilters</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>User module</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Contact module</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Plugin module</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>CSS/JS code that was no longer in use due to the above module removals</li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>Instructions from README.md that are no longer needed</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:paragraph -->
<p class="mb-3">As expected, several packages used by Frontend are not required:</p>
<!-- /wp:paragraph -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
