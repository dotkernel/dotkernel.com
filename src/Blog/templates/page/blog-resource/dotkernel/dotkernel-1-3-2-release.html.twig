{% extends '@layout/default.html.twig' %}
{% block json_ld %} {{ include('@jsonld/dotkernel/dotkernel-1-3-2-release.jsonld.twig') }} {% endblock %}

{% block title %}DotKernel 1.3.2 release{% endblock %}

{% block page_title %}
    <div class="wrap">
        <div class="post-hero">
            <a href="{{ url('page::blog') }}" class="breadcrumb-back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                Back to Blog
            </a>
            <div><span class="eyebrow">Dotkernel</span></div>
            <h1>{{ article.title }}</h1>
            <div class="post-meta">
                <span class="text-muted small">
                    By <a href="{{ path('page::author-resource', {slug: article.author.slug}) }}" class="fw-bold link-dark text-decoration-none">{{ article.author.name }}</a>
                    &nbsp;.&nbsp; {{ article.postDate|date('M d, Y') }}
                </span>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="wrap post-body-wrap">
        <div class="post-layout">

            {{ include('@partial/left-menu.html.twig') }}

            <article class="article">
                <div class="entry">
Before the winter holiday we came with a new release: <a href="http://www.dotkernel.com/download/?did=27">DotKernel 1.3.2</a>
It contains many bug fixes, some refactoring and a few minor features.

<!--more-->Bugs fixes:
<ul>
    <li style="text-decoration: line-through;"><a title=" Css phpinfo page admin" href="http://www.dotkernel.net/view.php?id=111">0000111</a>: <strong></strong> Css phpinfo page admin</li>
    <li style="text-decoration: line-through;"><a title=" warning in admin dashboard for file" href="http://www.dotkernel.net/view.php?id=115">0000115</a>: <strong></strong> warning in admin dashboard for file</li>
    <li style="text-decoration: line-through;"><a title=" WUFRL cache in admin" href="http://www.dotkernel.net/view.php?id=108">0000108</a>: <strong></strong> WUFRL cache in admin</li>
    <li style="text-decoration: line-through;"><a title=" WURLF version" href="http://www.dotkernel.net/view.php?id=94">0000094</a>: <strong></strong> WURLF version</li>
    <li style="text-decoration: line-through;"><a title=" Dot_Paginator Bug" href="http://www.dotkernel.net/view.php?id=112">0000112</a>: <strong></strong> Dot_Paginator Bug</li>
    <li style="text-decoration: line-through;"><a title=" Zend Paginator double query ?" href="http://www.dotkernel.net/view.php?id=109">0000109</a>: <strong></strong> Zend Paginator double query ?</li>
    <li style="text-decoration: line-through;"><a title=" Database naming convention" href="http://www.dotkernel.net/view.php?id=89">0000089</a>: <strong></strong> Database naming convention</li>
    <li style="text-decoration: line-through;"><a title=" Database normalisation/refactor" href="http://www.dotkernel.net/view.php?id=97">0000097</a>: <strong></strong> Database normalisation/refactor</li>
</ul>
Minor features:
<ul>
    <li style="text-decoration: line-through;"><a title=" validIP , class Dot_Kernel refactor" href="http://www.dotkernel.net/view.php?id=96">0000096</a>: <strong></strong> validIP , class Dot_Kernel refactor</li>
    <li style="text-decoration: line-through;"><a title=" WURFL date and api version in admin " href="http://www.dotkernel.net/view.php?id=99">0000099</a>: <strong></strong> WURFL date and api version in admin</li>
</ul>
Refactoring:
<ul>
    <li style="text-decoration: line-through;"><a title=" Zend_Paginator" href="http://www.dotkernel.net/view.php?id=110">0000110</a>: <strong></strong> Zend_Paginator</li>
    <li style="text-decoration: line-through;"><a title=" Add a dojo dijit theme to DotKernel" href="http://www.dotkernel.net/view.php?id=107">0000107</a>: <strong></strong> Add a dojo dijit theme to DotKernel</li>
</ul>
                </div>

                {{ include('@partial/post-nav.html.twig') }}
            </article>

        </div>
    </div>
{% endblock %}
