{% extends '@layout/default.html.twig' %}
{% block json_ld %} {{ include('@jsonld/dotkernel/dotkernel-light-the-best-choice-for-your-presentation-site.jsonld.twig') }} {% endblock %}

{% block title %}Dotkernel Light: the best choice for your presentation site{% endblock %}

{% block page_title %}
