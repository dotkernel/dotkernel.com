{% extends '@layout/default.html.twig' %}
{% block json_ld %} {{ include('@jsonld/dotkernel/forcing-utf8-connections-and-character-set-in-mysql.jsonld.twig') }} {% endblock %}

{% block title %}Forcing UTF8 connections and character set in MySQL{% endblock %}

{% block page_title %}
    <div class="wrap">
        <div class="post-hero">
            <a href="{{ url('page::blog') }}" class="breadcrumb-back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                Back to Blog
            </a>
            <div><span class="eyebrow">Dotkernel</span></div>
            <h1>{{ article.title }}</h1>
            <div class="post-meta">
                <span class="text-muted small">
                    By <a href="{{ path('page::author-resource', {slug: article.author.slug}) }}" class="fw-bold link-dark text-decoration-none">{{ article.author.name }}</a>
                    &nbsp;.&nbsp; {{ article.postDate|date('M d, Y') }}
                </span>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="wrap post-body-wrap">
        <div class="post-layout">

            {{ include('@partial/left-menu.html.twig') }}

            <article class="article">
                <div class="entry">
In some situations, it may be neccesar to force MySQL server collation and character set to UTF8.
As you can't control all scripts that are connecting to your database( for instance: mysql command line, or mysqldump)

For that , open the my.cnf file
and add the below lines:
<pre>>character_set_server=utf8
skip-character-set-client-handshake</pre>
If you are interested in better performance, add the below line:
<pre>>collation_server=utf8_general_ci</pre>
If you are interested in better sorting order, add the below line instead:
<pre>>collation_server=utf8_unicode_ci</pre>
                </div>

                {{ include('@partial/post-nav.html.twig') }}
            </article>

        </div>
    </div>
{% endblock %}
