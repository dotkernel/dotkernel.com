{% block title %}Zend_Session usage in DotKernel - Refactor of Dot_Session class{% endblock %}

{% block page_title %}
    <div class="wrap">
        <div class="post-hero">
            <a href="{{ url('page::blog') }}" class="breadcrumb-back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                Back to Blog
            </a>
