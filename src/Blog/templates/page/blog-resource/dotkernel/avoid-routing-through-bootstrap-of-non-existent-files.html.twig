{% extends '@layout/default.html.twig' %}

{% block title %}Avoid routing through bootstrap of non existent files{% endblock %}

{% block page_title %}
    <div class="wrap">
        <div class="post-hero">
            <a href="{{ url('page::blog') }}" class="breadcrumb-back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                Back to Blog
            </a>
            <div><span class="eyebrow">Dotkernel</span></div>
            <h1>{{ article.title }}</h1>
            <div class="post-meta">
                <span class="text-muted small">
                    By <a href="{{ path('page::author-resource', {slug: article.author.slug}) }}" class="fw-bold link-dark text-decoration-none">{{ article.author.name }}</a>
                    &nbsp;·&nbsp; {{ article.postDate|date('M d, Y') }}
                </span>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="wrap post-body-wrap">
        <div class="post-layout">

            {{ include('@partial/left-menu.html.twig') }}

            <article class="article">
                <div class="entry">
In some cases you may encounter missing files: images, css or js files.
All those missing files are processed by the current bootstrap: index.php

If the session is set to regenerate on each request, as a normal security measure,
the currently logged user is logged off, because the session ID is different now.

To avoid this, <strong>below</strong> the following line
<pre>>RewriteEngine On</pre>
add the line :
<pre>>RewriteCond %{REQUEST_FILENAME} (\.gif|\.jpg|\.png|\.css|\.js)$ </pre>
Save and don't forget to test.

Even though it's a well known fact that real men do not test...
                </div>

                {{ include('@partial/post-nav.html.twig') }}
            </article>

        </div>
    </div>
{% endblock %}
