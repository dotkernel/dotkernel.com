{% extends '@layout/default.html.twig' %}

{% block title %}Protecting admin folder with .htaccess in Plesk{% endblock %}

{% block page_title %}
    <div class="wrap">
        <div class="post-hero">
            <a href="{{ url('page::blog') }}" class="breadcrumb-back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                Back to Blog
            </a>
            <div><span class="eyebrow">Dotkernel</span></div>
            <h1>{{ article.title }}</h1>
            <div class="post-meta">
                <span class="text-muted small">
                    By <a href="{{ path('page::author-resource', {slug: article.author.slug}) }}" class="fw-bold link-dark text-decoration-none">{{ article.author.name }}</a>
                    &nbsp;.&nbsp; {{ article.postDate|date('M d, Y') }}
                </span>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="wrap post-body-wrap">
        <div class="post-layout">

            {{ include('@partial/left-menu.html.twig') }}

            <article class="article">
                <div class="entry">
In <strong>/var/www/vhosts/exampledomain.com/conf/vhost.conf</strong> file add this code:
<pre>>
< Location /admin>
   AuthType Basic
   AuthName "My Site Admin"
   AuthUserFile /var/www/vhosts/exampledomain.com/conf/.htpasswd
  Require valid-user
< /Location ></pre>
&nbsp;

Notice the server that vhost.conf has been added/changed with command:
<pre>>/usr/local/psa/admin/sbin/websrvmng -a</pre>
&nbsp;

Then create the .htpasswd file and upload it to <strong>/var/www/vhosts/exampledomain.com/conf/</strong>

<strong>
</strong>
                </div>

                {{ include('@partial/post-nav.html.twig') }}
            </article>

        </div>
    </div>
{% endblock %}
