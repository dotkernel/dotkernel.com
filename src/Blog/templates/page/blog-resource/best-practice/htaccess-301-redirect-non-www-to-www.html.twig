{% extends '@layout/default.html.twig' %}
{% block json_ld %} {{ include('@jsonld/best-practice/htaccess-301-redirect-non-www-to-www.jsonld.twig') }} {% endblock %}

{% block title %}htaccess 301 redirect non-www to www{% endblock %}

{% block page_title %}
    <div class="wrap">
        <div class="post-hero">
            <a href="{{ url('page::blog') }}" class="breadcrumb-back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                Back to Blog
            </a>
            <div><span class="eyebrow">Best Practice</span></div>
            <h1>{{ article.title }}</h1>
            <div class="post-meta">
                <span class="text-muted small">
                    By <a href="{{ path('page::author-resource', {slug: article.author.slug}) }}" class="fw-bold link-dark text-decoration-none">{{ article.author.name }}</a>
                    &nbsp;.&nbsp; {{ article.postDate|date('M d, Y') }}
                </span>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="wrap post-body-wrap">
        <div class="post-layout">

            {{ include('@partial/left-menu.html.twig') }}

            <article class="article">
                <div class="entry">
To always redirect users to the www site (for example: http://dotboost.com to http://www.dotboost.com), add the following lines to .htaccess, right after <strong>RewriteEngine On</strong>:

<pre>RewriteCond %{HTTP_HOST} ^dotboost.com
RewriteRule ^(.*)$ http://www.dotboost.com/$1 </pre>
<!--more-->
If, on the other hand, you want to redirect http://www.dotboost.com to http://dotboost.com, add the following lines instead:

<pre>RewriteCond %{HTTP_HOST} ^www.dotboost.com
RewriteRule ^(.*)$ http://dotboost.com/$1 </pre>

Replace dotboost.com with your site's domain.

<h2 id="user-content-faq">Frequently Asked Questions</h2>

<div class="faq-list">
    <details class="acc" open>
        <summary>How do I redirect a non-www domain to www using .htaccess? <span class="chev">+</span></summary>
        <div class="acc-body">
            <p class="mb-0">Add <code>RewriteCond %{HTTP_HOST} ^dotboost.com</code> and <code>RewriteRule ^(.*)$ http://www.dotboost.com/$1</code> to your .htaccess file, right after <strong>RewriteEngine On</strong>, replacing dotboost.com with your own domain.</p>
        </div>
    </details>
    <details class="acc">
        <summary>How do I redirect a www domain to non-www instead? <span class="chev">+</span></summary>
        <div class="acc-body">
            <p class="mb-0">Add <code>RewriteCond %{HTTP_HOST} ^www.dotboost.com</code> and <code>RewriteRule ^(.*)$ http://dotboost.com/$1</code> instead, again replacing dotboost.com with your own domain.</p>
        </div>
    </details>
</div>
                </div>

                {{ include('@partial/post-nav.html.twig') }}
            </article>

        </div>
    </div>
{% endblock %}
