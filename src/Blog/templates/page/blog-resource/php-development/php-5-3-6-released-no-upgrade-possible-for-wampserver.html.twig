{% extends '@layout/default.html.twig' %}

{% block title %}PHP 5.3.6 released. No upgrade possible for WampServer.{% endblock %}

{% block page_title %}
    <div class="wrap">
        <div class="post-hero">
            <a href="{{ url('page::blog') }}" class="breadcrumb-back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                Back to Blog
            </a>
            <div><span class="eyebrow">PHP Development</span></div>
            <h1>{{ article.title }}</h1>
            <div class="post-meta">
                <span class="text-muted small">
                    By <a href="{{ path('page::author-resource', {slug: article.author.slug}) }}" class="fw-bold link-dark text-decoration-none">{{ article.author.name }}</a>
                    &nbsp;.&nbsp; {{ article.postDate|date('M d, Y') }}
                </span>
            </div>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="wrap post-body-wrap">
        <div class="post-layout">

            {{ include('@partial/left-menu.html.twig') }}

            <article class="article">
                <div class="entry">
PHP 5.3.6 was released, but it come with a bad news for WampServer users:
<blockquote class="blockquote border-start border-4 ps-3 text-muted my-3">"Windows users: please mind that we do no longer provide builds created with Visual Studio C++ 6"</blockquote>
Since WampServer is built using VC++ 6,  is not possible an upgrade , without a rewrite from scratch of entire WampServer package.

More details on WampServer forum  <strong><a href="http://www.wampserver.com/phorum/read.php?2,72243" target="_blank" rel="noopener noreferrer">here </a></strong>
                </div>

                {{ include('@partial/post-nav.html.twig') }}
            </article>

        </div>
    </div>
{% endblock %}
