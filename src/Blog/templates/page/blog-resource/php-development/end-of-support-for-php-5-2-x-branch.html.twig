{% block title %}End of Support for PHP 5.2.x Branch{% endblock %}

{% block page_title %}
    <div class="mb-2 text-uppercase small fw-bold text-primary tracking-wider">PHP Development</div>
    <h1 class="fw-bold text-dark display-6 mb-0">End of Support for PHP 5.2.x Branch</h1>
    <hr class="mt-4 mb-2 opacity-25">
